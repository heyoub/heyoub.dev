{
  "name": "heyoub-dev",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "heyoub.dev — Eassa Ayoub. The real site, rebuilt on Astro + LiteShip (CZAP). Zero React.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "check": "astro check",
    "test": "playwright test",
    "audit:czap": "czap audit --consumer --pretty",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.0.1",
    "@astrojs/node": "^11.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "@czap/assets": "0.4.1",
    "@czap/astro": "0.4.1",
    "@czap/cloudflare": "0.4.1",
    "@czap/compiler": "0.4.1",
    "@czap/core": "0.4.1",
    "@czap/detect": "0.4.1",
    "@czap/edge": "0.4.1",
    "@czap/quantizer": "0.4.1",
    "@czap/scene": "0.4.1",
    "@czap/stage": "0.4.1",
    "@czap/vite": "0.4.1",
    "@czap/web": "0.4.1",
    "astro": "^7.0.0",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.32",
    "lenis": "^1.3.23",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@czap/audit": "0.4.1",
    "@czap/cli": "0.4.1",
    "@playwright/test": "^1.61.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.99.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "@czap/_spine": "0.4.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "msgpackr-extract",
      "workerd"
    ]
  }
}

---
import Layout from '@/layouts/Layout.astro'
import Scene from '@components/Scene.astro'
import ScrollProgress from '@components/ScrollProgress.astro'
import Nav from '@components/Nav.astro'
import Hero from '@components/Hero.astro'
import VideoInterlude from '@components/VideoInterlude.astro'
import CoreThesis from '@components/CoreThesis.astro'
import GalleryScroll from '@components/GalleryScroll.astro'
import OpenTo from '@components/OpenTo.astro'
import ParallaxVideo from '@components/ParallaxVideo.astro'
import ContactDecompile from '@components/ContactDecompile.astro'

// LiteShip device tier (resolved server-side by czapMiddleware). Two DIFFERENT
// asks, deliberately not one flag:
//
//   noData   — Save-Data ONLY. The visitor asked us not to spend their bytes, so
//              the 10MB clip IS the harm: brand gradient, download nothing.
//   noMotion — reduced motion, or a tier that can't drive video. The visitor can
//              afford ~100KB and can decode an image fine; they just can't have
//              the screen moving. They get the clip's own frame, held still.
//
// Note `tiers.tier === 'static'` belongs to noMotion, NOT noData: czap resolves
// prefers-reduced-motion to tier 'static', so putting it in noData routes every
// reduced-motion visitor into the metered-connection branch — the exact bug this
// split exists to kill. Bytes are a Save-Data concern; tier is a motion concern.
//
// These were one `lite` flag, which handed reduced-motion visitors a fallback
// designed for a metered connection: the artwork disappeared entirely and the
// glass card — which is 2-5% white and needs footage to frost against — collapsed
// into a transparent sheet. Reduced motion means don't move it, not don't show it.
const { tiers, capabilities } = Astro.locals.czap!
const noData = capabilities.connection?.saveData === true
const noMotion = tiers.motion === 'none' || tiers.tier === 'static'
---

<Layout>
  <!-- WebGL background — now a LiteShip GPU shader -->
  <Scene />

  <!-- Noise overlay -->
  <div class="noise-overlay"></div>

  <!-- Scroll progress -->
  <ScrollProgress />

  <!-- Navigation -->
  <Nav />

  <main class="relative">
    <!-- viewport-width query container for the boundary @container CSS;
         excludes the fixed ParallaxVideo so it stays viewport-fixed -->
    <div class="czap-vp">
      <Hero />

      <VideoInterlude src="/assets/fs/3141208-boomerang-web.mp4" height="82vh" overlay="gradient" noData={noData} noMotion={noMotion} />

      <CoreThesis />
      <GalleryScroll />
    </div>

    <!-- Duck-stack: the "Let's Build" section pins (sticky), then the parallax
         video rises up the viewport and slides OVER it — the section ducks
         behind the video. OpenTo keeps its own full-width .czap-vp so the
         czap-grid-3 @container context still resolves (the fixed video is a
         separate subtree, so it stays viewport-fixed). -->
    <div class="relative">
      <div class="duck-pin sticky top-0 z-0">
        <div class="czap-vp"><OpenTo /></div>
      </div>
      <div class="relative z-10">
        <ParallaxVideo noData={noData} noMotion={noMotion} />
      </div>
    </div>

    <ContactDecompile />
  </main>
</Layout>

<!-- Lenis smooth scroll + scroll-reveal init (vanilla, no React) -->
<script>
  import Lenis from 'lenis'
  import { initReveal } from '@/lib/reveal'

  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: true,
    wheelMultiplier: 1,
    touchMultiplier: 2,
    infinite: false,
  })

  function raf(time: number) {
    lenis.raf(time)
    requestAnimationFrame(raf)
  }
  requestAnimationFrame(raf)

  initReveal()

  // No astro:before-swap cleanup — no ClientRouter on this site, so the event
  // never fires; full-page nav tears down Lenis + the rAF loop anyway (was dead).
</script>

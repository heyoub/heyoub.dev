---
import Layout from '@/layouts/Layout.astro'
import Scene from '@components/Scene.astro'
import ScrollProgress from '@components/ScrollProgress.astro'
import Nav from '@components/Nav.astro'
import Hero from '@components/Hero.astro'
import VideoInterlude from '@components/VideoInterlude.astro'
import CoreThesis from '@components/CoreThesis.astro'
import GalleryScroll from '@components/GalleryScroll.astro'
import OpenTo from '@components/OpenTo.astro'
import ParallaxVideo from '@components/ParallaxVideo.astro'
import ContactDecompile from '@components/ContactDecompile.astro'

// LiteShip device tier (resolved server-side by czapMiddleware): drop the
// heavy autoplay videos to posters on Save-Data / reduced-motion / low-end.
const { tiers, capabilities } = Astro.locals.czap!
const lite = capabilities.connection?.saveData === true || tiers.motion === 'none' || tiers.tier === 'static'
---

<Layout>
  <!-- WebGL background — now a LiteShip GPU shader -->
  <Scene />

  <!-- Noise overlay -->
  <div class="noise-overlay"></div>

  <!-- Scroll progress -->
  <ScrollProgress />

  <!-- Navigation -->
  <Nav />

  <main class="relative">
    <!-- viewport-width query container for the boundary @container CSS;
         excludes the fixed ParallaxVideo so it stays viewport-fixed -->
    <div class="czap-vp">
      <Hero />

      <VideoInterlude src="/assets/fs/3141208-boomerang-web.mp4" height="82vh" overlay="gradient" lite={lite} />

      <CoreThesis />
      <GalleryScroll />
    </div>

    <!-- Duck-stack: the "Let's Build" section pins (sticky), then the parallax
         video rises up the viewport and slides OVER it — the section ducks
         behind the video. OpenTo keeps its own full-width .czap-vp so the
         czap-grid-3 @container context still resolves (the fixed video is a
         separate subtree, so it stays viewport-fixed). -->
    <div class="relative">
      <div class="duck-pin sticky top-0 z-0">
        <div class="czap-vp"><OpenTo /></div>
      </div>
      <div class="relative z-10">
        <ParallaxVideo lite={lite} />
      </div>
    </div>

    <ContactDecompile />
  </main>
</Layout>

<!-- Lenis smooth scroll + scroll-reveal init (vanilla, no React) -->
<script>
  import Lenis from 'lenis'
  import { initReveal } from '@/lib/reveal'

  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: 'vertical',
    gestureOrientation: 'vertical',
    smoothWheel: true,
    wheelMultiplier: 1,
    touchMultiplier: 2,
    infinite: false,
  })

  let rafId: number
  function raf(time: number) {
    lenis.raf(time)
    rafId = requestAnimationFrame(raf)
  }
  rafId = requestAnimationFrame(raf)

  initReveal()

  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(rafId)
    lenis.destroy()
  }, { once: true })
</script>

---
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
}
const {
  title = 'Eassa Ayoub — Cognitive-First Systems',
  description = 'Most software makes users carry its complexity. I build software that feels like thinking.',
} = Astro.props

// Server-resolved tier drives a body data-attribute so CSS can adapt the
// whole document to the device class without a client round-trip.
const { tier } = Astro.locals.czap
---

<!doctype html>
<html lang="en" data-czap-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content="Astro + LiteShip (CZAP)" />
    <link rel="icon" type="image/png" href="/assets/logo/AXLG.png" />
    <link rel="alternate" type="application/json" href="/manifest.json" title="Machine manifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
  </head>
  <body data-tier={tier.cap} data-motion={tier.motion}>
    <div class="scroll-progress"></div>
    <div class="noise"></div>
    <slot name="backdrop" />
    <slot />

    <!-- Continuous scroll signal → --czap-scroll CSS var + czap:uniform-update.
         The ~10-line bridge that unlocks scroll-driven shader/CSS motion the
         LiteShip-native way (Phase 3). -->
    <script>
      import { startScrollBridge } from '@/lib/scroll-bridge'
      startScrollBridge()
    </script>
  </body>
</html>

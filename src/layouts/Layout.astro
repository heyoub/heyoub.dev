---
interface Props {
  title?: string
  description?: string
}

const {
  title = 'Eassa Ayoub — Cognitive-First Systems',
  description = 'Most software makes users carry its complexity. I build software that feels like thinking — systems that match how humans actually work.',
} = Astro.props

import TokenStyles from '@components/TokenStyles.astro'
import '../styles/layout.quantize.css' // @quantize layout regimes → static @container queries (.czap-vp)
import DisplayFidelity from '@components/DisplayFidelity.astro'
import RenderBadge from '@components/RenderBadge.astro'
import WebMCP from '@components/WebMCP.astro'
import GraphRuntime from '@components/GraphRuntime.astro'
import MoodSvg from '@components/MoodSvg.astro'
import { CAP_AXES, capAxisAttr } from '@czap/detect'
import { Font } from 'astro:assets'
import { APEX_ORIGIN, canonicalUrlFor } from '../lib/url-canonical'

const siteUrl = APEX_ORIGIN
// Path-aware, apex-hosted canonical: built from the known apex origin plus the
// requested pathname, never from `Astro.url.href` (which would carry the request
// host — e.g. a `www` cohort — into an indexable canonical). Today the site is
// single-page, but Field Notes and other paths are coming, and each must
// self-canonicalize to `https://heyoub.dev/<path>`, matching the apex-only sitemap.
const canonicalUrl = canonicalUrlFor(Astro.url.pathname)
// Designed 1200×630 social card (public/og-card.png) — the transparent headshot
// stays the on-page hero image; a summary_large_image card reads far better when
// the link is unfurled in a feed.
const ogImage = `${siteUrl}/og-card.png`

// Server-resolved tier triple → <html> at first paint (the edge Client-Hints
// detection in Astro.locals.czap; cf. EdgeTier.tierDataAttributes). The
// documented rendering-sequence step 3 — the shell carries authored tier into
// the DOM so design-keyed CSS (wide-gamut palette), the gpu gate, and
// RenderBadge resolve with zero client flash; the client probe refines the same
// attrs on settle. cap + motion + design: 0.2.3 split the reduced-motion
// PREFERENCE onto data-czap-reduced-motion (our finding F1), so data-czap-motion
// is now purely the motion tier and no longer collides with the head script.
// 0.9.0 (bone 2): prefer the edge-forwarded spreadable attribute map —
// `locals.czap.edge.htmlAttributesMap` is the ready-made `data-czap-<axis>` set,
// sourced from the SAME edge resolution that produced the KV-cached boundary CSS,
// so shell and CSS can't drift and a future 4th cap axis auto-appears with no
// hand-maintained list. Fall back to rebuilding it from the CAP_AXES registry
// (the 0.6.0/0.8.0 path) for the prerendered-no-middleware path, where there is
// no request-time edge resolution (locals.czap.edge is absent); Astro drops any
// undefined attribute value so an omitted axis simply isn't stamped.
const czapTier = Astro.locals.czap?.tiers
const tierAttrs =
  Astro.locals.czap?.edge?.htmlAttributesMap ??
  Object.fromEntries(CAP_AXES.map((axis) => [capAxisAttr(axis), czapTier?.[axis]]))
---

<!DOCTYPE html>
<html lang="en" {...tierAttrs}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>

    <!-- Self-hosted fonts (Astro Fonts API) — preload the LCP-critical faces
         (Instrument Serif = hero h1, DM Sans = body); Space Mono loads with a
         metric-matched fallback. Replaces the render-blocking cross-origin Google
         Fonts request + its preconnect hints. -->
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-dm-sans" />
    <Font cssVariable="--font-space-mono" />

    <!-- Preload Critical Assets — the LCP headshot as AVIF (the format modern
         browsers use); non-AVIF browsers ignore this and load the eager PNG
         fallback in the hero <picture>. -->
    <link rel="preload" as="image" href="/assets/headshot.avif" type="image/avif" fetchpriority="high" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/logo/favicon-32.png" />
    <link rel="apple-touch-icon" href="/assets/logo/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="color-scheme" content="dark" />

    <!-- Primary Meta Tags -->
    <meta name="description" content={description} />
    <meta name="keywords" content="Systems Architecture, AI Infrastructure, Event Sourcing, Rust, TypeScript, Distributed Systems, Developer Tools, Philadelphia Developer" />
    <meta name="author" content="Eassa Ayoub" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eassa Ayoub - Cognitive-First Systems Architect" />
    <meta property="og:site_name" content="Eassa Ayoub Portfolio" />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Eassa" />
    <meta property="profile:last_name" content="Ayoub" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heyoub" />
    <meta name="twitter:creator" content="@heyoub" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Eassa Ayoub - Cognitive-First Systems" />

    <!-- AI Discovery & Schema -->
    <link rel="alternate" type="application/json+ld" href="/profile.json" title="AI-Readable Profile" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-Readable Profile" />
    <meta name="ai:profile" content="/profile.json" />
    <meta name="ai:capabilities" content="Systems Architecture, AI Infrastructure, Type Systems, Event Sourcing, Cross-Domain Integration" />
    <meta name="ai:contact" content="hello@heyoub.dev" />
    <meta name="ai:availability" content="open-to-opportunities" />
    <meta name="ai:response_time" content="24-48 hours" />

    <!-- JSON-LD Structured Data - Person -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": "https://heyoub.dev/#person",
      "name": "Eassa Ayoub",
      "givenName": "Eassa",

        "@type": "Organization",
        "name": "The Free Battery Factory",
        "url": "https://freebatteryfactory.com",
        "sameAs": "https://www.wikidata.org/wiki/Q140440449"
      }
    }
    </script>

    <!-- JSON-LD Structured Data - ProfilePage (Google's type for a page about a person) -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "@id": "https://heyoub.dev/#profilepage",
      "url": "https://heyoub.dev",
      "name": "Eassa Ayoub — Cognitive-First Systems",
      "mainEntity": { "@id": "https://heyoub.dev/#person" },
      "about": { "@id": "https://heyoub.dev/#person" },
      "inLanguage": "en-US"
    }
    </script>

    <!-- JSON-LD Structured Data - WebSite -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://heyoub.dev/#website",
      "url": "https://heyoub.dev",
      "name": "Eassa Ayoub Portfolio",
      "description": "Portfolio and professional profile of Eassa Ayoub, Cognitive-First Systems Architect",
      "publisher": {
        "@id": "https://heyoub.dev/#person"
      },
      "inLanguage": "en-US"
    }
    </script>

    <!-- JSON-LD Structured Data - FAQ for AI Answer Engines -->
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",

---
import { contactConfig, getLinkDisplayValue } from '@/data/footer'
const { links, status, code } = contactConfig
---

<footer id="footer" class="czap-vp bg-editor-bg border-t border-editor-border flex flex-col">
  <!-- Window chrome — no tabs (the products live in the cards above now); just the
       filename + traffic lights, so the footer is a single, content-height editor. -->
  <div role="presentation" class="flex justify-between items-center px-4 py-3 bg-editor-chrome border-b border-editor-border">
    <span class="font-mono text-xs text-text-muted flex items-center gap-2">
      <span class="text-[0.65rem] opacity-60" aria-hidden="true">⟨/⟩</span>{code.filename}
    </span>
    <div class="flex gap-2 shrink-0 ml-4" aria-hidden="true">
      <span class="w-3 h-3 rounded-full bg-editor-red"></span>
      <span class="w-3 h-3 rounded-full bg-editor-yellow"></span>
      <span class="w-3 h-3 rounded-full bg-editor-green"></span>
    </div>
  </div>

  <!-- Code content — contact only -->
  <div class="relative">
    <div aria-hidden="true" class="czap-editor-gutter absolute left-0 top-0 bottom-0 w-12 bg-editor-bg border-r border-editor-border py-6 pr-4">
      <div class="flex flex-col items-end font-mono text-xs text-editor-gray leading-relaxed" data-linenums></div>
    </div>

    <div class="code-block font-mono text-[clamp(0.7rem,1.5vw,0.875rem)] leading-relaxed">
      <div data-panel="contact">
        <p class="code-line"><span class="code-comment code-comment--with-slashes">{code.filename}</span></p>
        <p class="code-line"><span class="code-comment code-comment--with-slashes">{code.openComment}</span></p>
        <p class="code-line">&nbsp;</p>
        <p class="code-line"><span class="code-keyword">const</span> <span class="code-variable">links</span> <span class="code-punctuation">=</span> <span class="code-punctuation">{'{'}</span></p>
        <dl class="code-object-body">
          {links.map((link, i) => (
            <div class="code-line code-property">
              <dt class="code-key">{link.key}</dt>
              <dd><a href={link.href} class="code-string code-link" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{getLinkDisplayValue(link)}</a><span class="code-punctuation" aria-hidden="true">{i < links.length - 1 ? ',' : ''}</span></dd>
            </div>
          ))}
        </dl>
        <p class="code-line"><span class="code-punctuation">{'};'}</span></p>
        <p class="code-line">&nbsp;</p>
        <p class="code-line"><span class="code-keyword">const</span> <span class="code-variable">status</span> <span class="code-punctuation">=</span> <span class="code-punctuation">{'{'}</span></p>
        <address class="code-object-body not-italic">
          <div class="code-line code-property"><span class="code-key">building</span><span class="code-boolean">{String(status.building)}</span><span class="code-punctuation" aria-hidden="true">,</span></div>
          <div class="code-line code-property"><span class="code-key">available</span><span class="code-boolean">{String(status.available)}</span><span class="code-punctuation" aria-hidden="true">,</span></div>
          <div class="code-line code-property"><span class="code-key">location</span><span class="code-string">{status.location}</span><span class="code-punctuation" aria-hidden="true">,</span></div>
          <div class="code-line code-property"><span class="code-key">year</span><span class="code-number">{status.year}</span></div>
        </address>
        <p class="code-line"><span class="code-punctuation">{'};'}</span></p>
        <p class="code-line">&nbsp;</p>
        <p class="code-line"><span class="code-comment code-comment--with-slashes">{code.closeComment}</span></p>
      </div>
    </div>
  </div>

  <!-- Status bar -->
  <div role="status" class="czap-editor-indent flex justify-between items-center py-3 bg-editor-chrome border-t border-editor-border">
    <div class="flex items-center gap-3 text-editor-gray-light">
      <span class="w-2 h-2 rounded-full bg-green animate-pulse" aria-hidden="true"></span>
      <span class="font-mono text-xs">open to work</span>
    </div>
    <small class="font-mono text-[0.65rem] tracking-wider text-editor-gray">© {status.year} Eassa Ayoub · {status.location}</small>
  </div>
</footer>

<script>
  // Fill the line-number gutter for the single contact panel (no tabs to switch).
  const panel = document.querySelector<HTMLElement>('[data-panel="contact"]')
  const gutter = document.querySelector<HTMLElement>('[data-linenums]')
  if (panel && gutter) {
    const n = Math.max(panel.querySelectorAll('.code-line, .code-property').length, 1)
    gutter.innerHTML = Array.from({ length: n }, (_, i) => `<span>${i + 1}</span>`).join('')
  }
</script>

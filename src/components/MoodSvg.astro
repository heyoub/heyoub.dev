---
// #8 — client:svg last-mile cast. A small corner beacon whose SVG presentation
// attributes (fill/opacity) are written live by @czap/scene's applySvgAttrs on
// every sceneMood crossing — the SVG arm of the same boundary that drives the
// GPU orbs and the CSS mood vars. Self-contained: the svg directive parses the
// serialized boundary off data-czap-boundary and self-evaluates scroll.progress
// (no scene runtime, no graph dependency). Completes the cast family:
// CSS + GPU(GLSL/WGSL) + SVG + ARIA, all from one boundary.
import { satelliteAttrs } from '@czap/astro'
import { sceneMood } from '@/lib/boundaries'

// satelliteAttrs serializes the boundary into data-czap-boundary (the signal
// clock the svg directive reads to decide which state is live).
const boundaryAttr = satelliteAttrs({ boundary: sceneMood })['data-czap-boundary']

// Per-state SVG attrs. applySvgAttrs writes only transform / opacity / clip-path,
// so the live cast drives OPACITY — the beacon brightens to full at the kinetic
// `work` mood and dims at the calm ends. (fill is fixed; not an applySvgAttrs target.)
const moodSvg = JSON.stringify({
  arrival: { opacity: '0.3' },
  thesis: { opacity: '0.55' },
  work: { opacity: '1' },
  sendoff: { opacity: '0.65' },
})
---

<div class="mood-svg" data-czap-directive="svg" aria-hidden="true">
  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle
      cx="13"
      cy="13"
      r="8"
      data-czap-entity="mood-beacon"
      data-czap-svg={moodSvg}
      data-czap-boundary={boundaryAttr}
      fill="rgb(34,211,238)"
      opacity="0.3"
    />
    <circle cx="13" cy="13" r="11.5" stroke="currentColor" stroke-opacity="0.12" />
  </svg>
</div>

<style>
  .mood-svg {
    position: fixed;
    bottom: 1.1rem;
    right: 1.1rem;
    z-index: 50;
    pointer-events: none;
    color: var(--text-muted, #888);
    opacity: 0.8;
  }
  /* smooth the opacity crossings (applySvgAttrs sets the attribute; CSS eases it) */
  .mood-svg circle[data-czap-entity] {
    transition: opacity 0.9s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .mood-svg {
      display: none;
    }
  }
</style>

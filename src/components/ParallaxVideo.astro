---
// Fixed-background video parallax (webflow-style) — "The pattern persists".
// On Save-Data / low tier the video is replaced by a static gradient.
interface Props { lite?: boolean }
const { lite = false } = Astro.props
---

<div class="relative h-[60vh] lg:h-[80vh] -mx-[8vw]" style="clip-path: inset(0)">
  {lite ? (
    <div class="fixed inset-0 w-full h-full pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--purple) 22%, transparent), var(--bg-primary))"></div>
  ) : (
    <video
      class="fixed inset-0 w-full h-full object-cover pointer-events-none"
      src="/assets/fs/numbers-ticker.mp4"
      aria-hidden="true"
      muted loop playsinline autoplay preload="metadata"
    ></video>
  )}

  <div class="absolute inset-0 pointer-events-none" style="box-shadow: inset 0 0 150px 60px var(--bg-primary)"></div>

  <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none pv-text">
    <h3 class="font-serif text-[clamp(2rem,5vw,3.5rem)] text-center leading-tight"
      style="background: linear-gradient(135deg,#ffffff 0%,rgba(255,255,255,0.9) 50%,#ffffff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; text-shadow: 0 0 40px rgba(165,105,251,0.4), 0 0 80px rgba(165,105,251,0.2); filter: drop-shadow(0 4px 20px rgba(0,0,0,0.5));">
      The pattern persists
    </h3>
  </div>
</div>

<style>
  /* text peaks in the middle of the viewport pass (v2 bell-curve opacity) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .pv-text {
        animation: pv-peak linear both;
        animation-timeline: view();
        animation-range: cover 20% cover 80%;
      }
    }
  }
  @keyframes pv-peak { 0% { opacity: 0; } 50% { opacity: 1; } 100% { opacity: 0; } }
</style>

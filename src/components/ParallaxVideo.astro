---
// Fixed-background video parallax (webflow-style) — "The pattern persists".
// Save-Data / low tier gets a static gradient (spend no bytes). Reduced motion
// gets the clip's own frame held still — the ticker texture IS the artwork here,
// so a gradient threw it away for a visitor who could afford to see it.
//
// fetchpriority="low" on the poster/still/video: this element is fixed inset-0
// and revealed only when the duck-stack scrolls over it, but as a viewport-filling
// fixed element its poster was a large early paint competing with the hero headshot
// for LCP (issue #6). Deprioritising the fetch lets the preloaded headshot win the
// load race. Zero visual change — nothing here is seen until scroll.
interface Props {
  /** Save-Data / static tier: brand gradient, no download. */
  noData?: boolean
  /** prefers-reduced-motion: the ticker frame, held still. */
  noMotion?: boolean
}
const { noData = false, noMotion = false } = Astro.props
---

<div class="relative h-[60vh] lg:h-[80vh]" style="clip-path: inset(0)">
  {noData ? (
    <div class="fixed inset-0 w-full h-full pointer-events-none" aria-hidden="true"
      style="background: radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--purple) 22%, transparent), var(--bg-primary))"></div>
  ) : noMotion ? (
    /* Same fixed/object-cover geometry as the <video> below, so the duck-stack
       still slides over it identically — only the motion is gone. */
    <img src="/assets/fs/parallax-still.webp" alt="" aria-hidden="true" decoding="async" fetchpriority="low"
      class="fixed inset-0 w-full h-full object-cover pointer-events-none" />
  ) : (
    <video
      class="fixed inset-0 w-full h-full object-cover pointer-events-none"
      aria-hidden="true"
      muted loop playsinline autoplay preload="metadata" fetchpriority="low"
      poster="/assets/fs/parallax-poster.webp"
    >
      <!-- Explicit av01 codec string is REQUIRED: bare type="video/webm" reads as
           canPlayType "maybe" on iOS Safari 17.4+, so iOS picks the webm, fails to
           decode AV1, and shows a black gap with no fallback. The codec string makes
           iOS return "" and fall through to the H.264 mp4. av01.0.05M.08 = Main,
           seq-level 5 (this clip), 8-bit. (see VideoInterlude for the full note.) -->
      <source src="/assets/fs/numbers-ticker-web.webm" type='video/webm; codecs="av01.0.05M.08"' />
      <source src="/assets/fs/numbers-ticker-web.mp4" type="video/mp4" />
    </video>
  )}

  <!-- Side + bottom vignette (no top, so the entry fade owns the top edge). -->
  <div class="absolute inset-0 pointer-events-none"
    style="box-shadow: inset 0 -150px 120px -20px var(--bg-primary), inset 150px 0 130px -60px var(--bg-primary), inset -150px 0 130px -60px var(--bg-primary)"></div>

  <!-- Top entry fade — anchored INSIDE this wrapper, so it scrolls with the clip
       window and always covers the leading edge (kills the hard line; a mask on
       the viewport-fixed video can't track the clip window). -->
  <div class="absolute top-0 inset-x-0 h-40 pointer-events-none bg-gradient-to-b from-bg-primary to-transparent"></div>

  <div class="absolute inset-0 flex items-center justify-center z-20 pointer-events-none pv-text" style="background: radial-gradient(44% 26% at 50% 50%, rgba(8,8,10,0.62), rgba(8,8,10,0.2) 55%, transparent 72%)">
    <h3 class="font-serif text-[clamp(2rem,5vw,3.5rem)] text-center leading-tight"
      style="background: linear-gradient(135deg,#ffffff 0%,rgba(255,255,255,0.9) 50%,#ffffff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; text-shadow: 0 0 40px rgba(165,105,251,0.4), 0 0 80px rgba(165,105,251,0.2); filter: drop-shadow(0 4px 20px rgba(0,0,0,0.5));">
      The pattern persists
    </h3>
  </div>
</div>

<style>
  /* text peaks in the middle of the viewport pass (v2 bell-curve opacity) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .pv-text {
        animation: pv-peak linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }
  /* Hold full opacity across the middle ~40% of the pass so it lingers instead
     of fading in and straight back out. */
  @keyframes pv-peak { 0% { opacity: 0; } 28% { opacity: 1; } 70% { opacity: 1; } 100% { opacity: 0; } }
</style>

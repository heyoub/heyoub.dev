---
import { pillars, pathContent as p } from '@/data/content'
import { proofPoints } from '@/data/projects'

const proofByPrinciple = Object.fromEntries(proofPoints.map((pp) => [pp.principle, pp]))
const principles = ['attention', 'rent', 'constraints'] as const
const pillarFor = { attention: pillars[0]!, rent: pillars[1]!, constraints: pillars[2]! }
---

<section class="proof wrap" id="proof">
  <header class="head reveal">
    <p class="kicker">{p.sectionLabel}</p>
    <h2 class="title">{p.heading.join(' ')}</h2>
    <p class="body measure">{p.body}</p>
  </header>

  <div class="pillars">
    {principles.map((key) => {
      const pillar = pillarFor[key]
      const pp = proofByPrinciple[key]
      return (
        <article class={`pillar reveal pillar--${pillar.accent}`}>
          <span class="p-label mono">{pillar.label}</span>
          <h3 class="p-title">{pillar.title}</h3>
          <p class="p-summary">{pillar.summary}</p>
          <ul class="p-details">
            {pillar.details.map((d) => <li>{d}</li>)}
          </ul>
          {pp && <p class="p-proof mono">{pp.proof}</p>}
        </article>
      )
    })}
  </div>
</section>

<style>
  .proof { position: relative; z-index: 2; padding-block: var(--section-y); }
  .head { margin-bottom: 3rem; }
  .title { font-family: var(--font-serif); font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.05; margin: 0.75rem 0 1.25rem; }
  .body { color: var(--muted); font-size: clamp(1rem, 2.2vw, 1.2rem); }

  .pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 1.25rem; }
  .pillar {
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
    border-radius: 0.75rem;
    padding: 1.75rem;
    background: color-mix(in srgb, var(--bg-2) 60%, transparent);
    transition: transform 0.25s, border-color 0.25s;
  }
  .pillar:hover { transform: translateY(-4px); }
  .pillar--accent:hover { border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .pillar--purple:hover { border-color: color-mix(in srgb, var(--purple) 45%, transparent); }
  .pillar--green:hover { border-color: color-mix(in srgb, var(--green) 45%, transparent); }

  .p-label { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .pillar--accent .p-label { color: var(--accent); }
  .pillar--purple .p-label { color: var(--purple); }
  .pillar--green .p-label { color: var(--green); }
  .p-title { font-family: var(--font-serif); font-size: 1.35rem; margin: 0.6rem 0 0.4rem; }
  .p-summary { color: var(--muted); margin-bottom: 1rem; }
  .p-details { list-style: none; display: grid; gap: 0.45rem; margin-bottom: 1.25rem; }
  .p-details li { position: relative; padding-left: 1.1rem; font-size: 0.9rem; color: var(--muted); }
  .p-details li::before { content: '→'; position: absolute; left: 0; color: var(--faint); }
  .p-proof { font-size: 0.8rem; color: var(--text); border-top: 1px dashed color-mix(in srgb, var(--text) 10%, transparent); padding-top: 0.9rem; }
</style>

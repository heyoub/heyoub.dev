---
import { satelliteAttrs } from '@czap/astro'
import { heroLayout } from '@/lib/boundaries'

// Tier-gated GPU backdrop. We omit the canvas entirely for reduced-motion
// (motion tier 'none'); the @czap GPU runtime additionally skips WebGL init
// on static/styled capability tiers — the static gradient shows through.
const { tier } = Astro.locals.czap
const showCanvas = tier.motion !== 'none'

// Carry the SAME heroLayout boundary onto the canvas so its u_state uniform
// and the hero's CSS layout move together. The scroll bridge feeds u_scroll.
const sat = satelliteAttrs({ boundary: heroLayout })
---

<div class="field" aria-hidden="true">
  {showCanvas && (
    <canvas
      class="field-canvas"
      data-czap-boundary={sat['data-czap-boundary']}
      data-czap-shader-type="glsl"
      data-czap-shader-src="/shaders/field.frag"
    ></canvas>
  )}
</div>

{showCanvas && (
  <script>
    // Astro ignores custom client directives on plain elements, so we invoke
    // @czap's real GPU runtime directly — same code path `client:gpu` would
    // run on an island. It fetches the shader, compiles, runs the rAF loop,
    // and listens for czap:uniform-update (our scroll bridge feeds u_scroll).
    import gpuDirective from '@czap/astro/client-directives/gpu'
    const mount = () => {
      const el = document.querySelector('.field-canvas')
      if (el) gpuDirective(() => Promise.resolve({ default: () => {} }), {}, el as HTMLElement)
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', mount, { once: true })
    } else {
      mount()
    }
  </script>
)}

<style>
  .field {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* static fallback shown on low tiers / reduced-motion / before hydrate */
    background:
      radial-gradient(50% 50% at 70% 15%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 60%),
      radial-gradient(45% 45% at 25% 80%, color-mix(in srgb, var(--purple) 9%, transparent), transparent 60%),
      var(--bg);
  }
  .field-canvas { width: 100%; height: 100%; display: block; }
</style>

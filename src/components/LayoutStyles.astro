---
import { compileLayoutCss } from '@/lib/layout-css'

// Boundary-driven @container layout CSS. On Cloudflare the middleware caches
// the compiled output in Workers KV keyed by (boundary, tier) — a cache hit
// hands it to us through locals.czap.edge.compiledOutputs and we skip the
// recompile. Anywhere else (dev, cache miss) we compile inline; both paths
// share src/lib/layout-css.ts so the CSS is byte-identical.
const edge = Astro.locals.czap?.edge
const css = edge?.compiledOutputs?.css || compileLayoutCss()
---

<style is:global set:html={css}></style>

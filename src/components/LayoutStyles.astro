---
import { compileLayoutCss, CONTAINER_RULE } from '@/lib/layout-css'

// Boundary-driven @container layout CSS. On Cloudflare the middleware caches
// each layout boundary in Workers KV keyed by (its own content address, tier).
// With the multi-boundary cache form the per-boundary outputs arrive in
// locals.czap.edge.boundaries (a name-keyed map) — concat each boundary's css.
// Anywhere else (dev, cache miss, non-edge) we compile inline; both paths share
// src/lib/layout-css.ts so the CSS is byte-identical. CONTAINER_RULE (.czap-vp
// container-type) is static + boundary-invariant, so it's emitted once here
// rather than cached per boundary.
const edge = Astro.locals.czap?.edge
const fromEdge = edge?.boundaries
  ? Object.values(edge.boundaries)
      .map((b) => b.compiledOutputs?.css ?? '')
      .join('\n')
  : edge?.compiledOutputs?.css
const css = `${CONTAINER_RULE}\n${fromEdge || compileLayoutCss()}`
---

<style is:global set:html={css}></style>

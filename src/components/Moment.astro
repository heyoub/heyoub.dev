---
import { momentContent as m } from '@/data/content'
---

<section class="moment" id="moment">
  <div class="lines wrap reveal">
    {m.lines.map((line) => (
      line === '' ? <span class="gap"></span> : <p class="line">{line}</p>
    ))}
    <p class="closer">
      {m.closer.before} <em class="c-accent">{m.closer.emphasis}</em>
    </p>
  </div>
</section>

<style>
  .moment {
    position: relative;
    z-index: 2;
    padding: var(--section-y) 0;
    background:
      radial-gradient(60% 80% at 50% 0%, color-mix(in srgb, var(--purple) 8%, transparent), transparent),
      var(--bg-2);
    border-block: 1px solid color-mix(in srgb, var(--text) 5%, transparent);
  }
  .lines { max-width: 50rem; }
  .line {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3.5vw, 2.1rem);
    line-height: 1.35;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .line:nth-child(odd) { color: var(--text); }
  .gap { display: block; height: 1.5rem; }
  .closer {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 5vw, 3rem);
  }
  .closer em { font-style: italic; }
</style>

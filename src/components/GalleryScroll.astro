---
import { proofPoints } from '@/data/projects'
import { pathContent, pillars, productCards } from '@/data/content'

const principleMap = { attention: pillars[0]!, rent: pillars[1]!, constraints: pillars[2]! } as const
---

<section id="work" class="relative px-[8vw] pb-[12vh]">
  <!-- Sticky fading header -->
  <div class="sticky top-20 z-0 py-[clamp(2.5rem,8vw,6rem)] pointer-events-none gallery-header">
    <div>
      <div class="section-label">The Work</div>
      <h2 class="font-serif text-[clamp(1.5rem,4vw,2.5rem)] max-w-2xl pl-[2px]">Where the pattern shows up</h2>
    </div>
  </div>

  <!-- Card deck — same-shape cards that PIN (sticky) and stack over one another as
       you scroll: each rises, covers the one before, holds; the whole deck scrolls
       up once complete. NO data-reveal here — its transform would break sticky. -->
  <div class="card-deck">
    <!-- Card 1 — the pattern -->
    <article class="stack-card gallery-card relative bg-bg-tertiary border border-white/5" style="z-index:1">
      <div class="absolute top-0 left-0 w-16 h-px bg-gradient-to-r from-accent to-transparent"></div>
      <div class="absolute top-0 left-0 h-16 w-px bg-gradient-to-b from-accent to-transparent"></div>
      <div class="grid czap-split-2 h-full">
        <div class="flex flex-col justify-center">
          <div class="section-label">The Pattern</div>
          <h3 class="font-serif text-[clamp(1.5rem,4vw,2.5rem)] mb-6 leading-tight">
            {pathContent.heading[0]}<br /><span class="text-text-secondary">{pathContent.heading[1]}</span>
          </h3>
          <p class="text-text-secondary font-light text-[clamp(0.95rem,2vw,1.1rem)] leading-relaxed">{pathContent.body}</p>
        </div>

        <div class="flex flex-col justify-center space-y-6">
          {proofPoints.map((point) => {
            const principle = principleMap[point.principle]
            return (
              <div class="group">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-1.5 h-1.5 rounded-full" style={`background-color: var(--${principle.accent})`}></div>
                  <span class="font-mono text-[clamp(0.6rem,1.25vw,0.7rem)] tracking-wider uppercase text-accent">{principle.label}</span>
                </div>
                <p class="text-text-secondary text-[clamp(0.85rem,1.5vw,0.95rem)] mb-2 pl-4 border-l border-white/10 group-hover:border-accent/30 transition-colors">
                  {principle.title} — <span class="text-text-muted">{principle.summary}</span>
                </p>
                <p class="text-text-primary text-[clamp(0.9rem,1.75vw,1rem)] pl-4 font-light">
                  → {point.proof}
                  {point.link && (
                    <a href={point.link.url} target="_blank" rel="noopener noreferrer" class="ml-2 text-accent/70 hover:text-accent text-[clamp(0.7rem,1.25vw,0.8rem)] font-mono transition-colors">[{point.link.label}]</a>
                  )}
                </p>
              </div>
            )
          })}
        </div>
      </div>
    </article>

    <!-- Cards 2+ — the products, same shape + same title/write-up/3-points format -->
    {productCards.map((p, i) => (
      <article class="stack-card gallery-card relative bg-bg-tertiary border border-white/5" style={`z-index:${i + 2}`}>
        <div class="absolute top-0 left-0 w-16 h-px" style={`background: linear-gradient(to right, var(--${p.accent}), transparent)`}></div>
        <div class="absolute top-0 left-0 h-16 w-px" style={`background: linear-gradient(to bottom, var(--${p.accent}), transparent)`}></div>
        <div class="grid czap-split-2 h-full">
          <div class="flex flex-col justify-center">
            <div class="font-mono text-[clamp(0.6rem,1.25vw,0.7rem)] tracking-wider uppercase mb-3" style={`color: var(--${p.accent})`}>Product</div>
            <h3 class="font-serif text-[clamp(1.5rem,4vw,2.5rem)] mb-3 leading-tight">{p.name}</h3>
            <p class="font-serif italic text-[clamp(1rem,2.2vw,1.25rem)] text-text-secondary leading-snug mb-5">{p.tagline}</p>
            <p class="text-text-secondary font-light text-[clamp(0.9rem,1.75vw,1.05rem)] leading-relaxed mb-6">{p.body}</p>
            <a href={p.link.url} target="_blank" rel="noopener noreferrer" class="font-mono text-[clamp(0.7rem,1.25vw,0.8rem)] tracking-wider self-start hover:opacity-70 transition-opacity" style={`color: var(--${p.accent})`}>{p.link.label} →</a>
          </div>

          <div class="flex flex-col justify-center space-y-6">
            {p.points.map((pt) => (
              <div class="group">
                <div class="flex items-center gap-3 mb-2">
                  <div class="w-1.5 h-1.5 rounded-full" style={`background-color: var(--${p.accent})`}></div>
                  <span class="font-mono text-[clamp(0.6rem,1.25vw,0.7rem)] tracking-wider uppercase" style={`color: var(--${p.accent})`}>{pt.label}</span>
                </div>
                <p class="text-text-secondary text-[clamp(0.9rem,1.75vw,1rem)] pl-4 border-l border-white/10 group-hover:border-white/20 transition-colors font-light">
                  {pt.title} — <span class="text-text-muted">{pt.detail}</span>
                </p>
              </div>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  /* header fades as you scroll past it (v2 scroll-linked fade) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .gallery-header {
        animation: gh-fade linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 80%;
      }
    }
  }
  @keyframes gh-fade { to { opacity: 0; transform: translateY(-20px); } }

  /* The card deck's layout lives in the @quantize layer — src/styles/
     layout.quantize.css, `.card-deck > .stack-card` base + splitLayout.two — so
     the phone/desktop switch is single-sourced with every other regime instead
     of a hand-written media query here. Below the split the cards FLOW and get
     the scroll-driven card-deal entrance (they're taller than a phone viewport,
     so a pinned card's tail would be unreachable); at splitLayout.two the true
     sticky STACK takes over and the entrance is cancelled. */
</style>

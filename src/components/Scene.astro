---
// The WebGL background — now a LiteShip GPU shader cast (no more vanilla
// three.js). A full-screen fragment shader (/shaders/scene.frag) hydrated by
// the `gpu` client directive (booted natively off the data-czap-directive
// marker, like the hero's worker). The sceneMood boundary drives it: scroll →
// blended uniforms via czap:uniform-update (scene-mood.ts), on the RAF spine.
//
// Server omits the canvas for reduced-motion (motion tier 'none'); the gpu
// directive itself also no-ops on static/styled tiers — both leave the CSS
// gradient fallback (which still breathes via the --czap-mood-* cast).
import { satelliteAttrs } from '@czap/astro'
import { sceneMood } from '@/lib/boundaries'
import { MOOD_GLSL, MOOD_STATES } from '@/data/scene-moods'

const { tier } = Astro.locals.czap
const show = tier.motion !== 'none'

// Per-state GLSL uniform payload — u_-prefixed to match scene.frag's uniforms.
// Carried on the satellite so the inspector shows the active glsl cast; the
// continuous values are streamed by the RAF bridge.
const glslStates = Object.fromEntries(
  MOOD_STATES.map((s) => [s, Object.fromEntries(Object.entries(MOOD_GLSL[s]).map(([k, v]) => [`u_${k}`, v]))]),
)
const { class: satClass, ...satData } = satelliteAttrs({ boundary: sceneMood, directive: 'gpu', glsl: glslStates })
---

<div class="scene" aria-hidden="true">
  {show && (
    <canvas
      class:list={['scene-canvas', satClass]}
      data-czap-shader-type="glsl"
      data-czap-shader-src="/shaders/scene.frag"
      {...satData}
    ></canvas>
  )}
</div>

{show && (
  <!-- The net-new WGSL/WebGPU cast is opt-in via ?cast=wgsl. GLSL is the default
       everywhere: WGSL's uniform buffer is 4 slots with no room for resolution,
       so it can't run the aspect-correct raymarch the GLSL cast does — GLSL is
       the richer visual; WGSL stays a demonstrable artifact on WebGPU devices.
       Runs at parse time (is:inline) so attributes flip before the gpu directive
       boots. (preferWebGPU integration config is an upstream no-op.) -->
  <script is:inline>
    (function () {
      var search = location.search
      // ?cast=wgsl — opt into the net-new WGSL/WebGPU path.
      if (('gpu' in navigator) && /[?&]cast=wgsl/.test(search)) {
        var c0 = document.querySelector('.scene-canvas')
        if (c0) {
          c0.setAttribute('data-czap-shader-type', 'wgsl')
          c0.setAttribute('data-czap-shader-src', '/shaders/scene.wgsl')
        }
      }
      // ?gl=force just flags an override; the single re-scan that lifts the
      // tier lives in the module script below (one place → no double-boot).
      if (/[?&]gl=force/.test(search)) window.__CZAP_GL_FORCE__ = true
    })()
  </script>
)}

{show && (
  <script>
    import { initSceneMood } from '@/lib/scene-mood'

    const start = (): void => {
      const canvas = document.querySelector<HTMLCanvasElement>('.scene-canvas')
      if (!canvas) return
      // The gpu directive owns the GL context + RAF loop; we own the scroll →
      // uniform bridge. It no-ops on reduced-motion internally.
      const mood = initSceneMood(canvas)

      // The integration's GPU probe upgrades data-czap-tier AFTER the boot scan,
      // so a capable device can boot the directive against the conservative
      // initial tier and bail (the canvas stays at its default 300x150). If it
      // hasn't rendered shortly after, clear the bound marker and re-run the
      // scanner so the directive re-reads the now-upgraded tier. Idempotent:
      // once rendered (canvas backing == display size) we stop; a genuinely
      // low-tier device just re-bails and keeps the CSS fallback.
      // This site's hero shows its shader on any WebGL2-capable, motion-OK
      // device. The GPU probe tiers conservatively AND upgrades data-czap-tier
      // AFTER the boot scan, so the directive bails on the initial tier; we lift
      // it ourselves and re-run the scanner ONCE (a retry only if a slow boot
      // never landed). Spaced 2.6s so an in-flight shader compile always
      // finishes first — re-scanning mid-compile would spawn a 2nd render loop
      // (the flicker/lag). Renders only when the canvas is still default-sized
      // (i.e. the directive bailed); reduced-motion / no-WebGL2 keep the CSS
      // fallback.
      const forced = (window as unknown as { __CZAP_GL_FORCE__?: boolean }).__CZAP_GL_FORCE__ === true
      const motionOK = forced || !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const capable = forced || 'WebGL2RenderingContext' in window
      let attempts = 0
      const ensure = (): void => {
        if (canvas.clientWidth > 0 && canvas.width === canvas.clientWidth) return // already rendering
        if (attempts++ >= 2 || !motionOK || !capable) return
        document.documentElement.setAttribute('data-czap-tier', 'gpu')
        canvas.removeAttribute('data-czap-directive-bound')
        document.dispatchEvent(new CustomEvent('astro:after-swap'))
        setTimeout(ensure, 2600)
      }
      setTimeout(ensure, 700)

      document.addEventListener('astro:before-swap', () => mood.dispose(), { once: true })
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true })
    else start()
  </script>
)}

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: -100;
    pointer-events: none;
    /* Static fallback shown on low tiers / reduced-motion / before the shader
       mounts. --czap-mood-glow is the sceneMood boundary's CSS cast — on tiers
       where the GLSL target is gated off, the same blend breathes through this
       gradient. */
    background:
      radial-gradient(40% 40% at 78% 24%, color-mix(in srgb, #06b6d4 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 60%),
      radial-gradient(38% 38% at 22% 78%, color-mix(in srgb, #8b5cf6 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 60%),
      var(--bg-primary);
    transition: background 900ms ease;
  }
  .scene-canvas { width: 100%; height: 100%; display: block; }
</style>

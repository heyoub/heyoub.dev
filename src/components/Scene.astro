---
// The WebGL background — a real Three.js scene (orbs + grid), driven by
// LiteShip. Server omits it for reduced-motion (motion tier 'none'); the
// client also bails on static/styled capability tiers, leaving the CSS
// gradient fallback. Three.js is lazy-imported so low-end devices that bail
// never download it.
const { tier } = Astro.locals.czap
const show = tier.motion !== 'none'
---

<div class="scene" aria-hidden="true">
  {show && <canvas class="scene-canvas"></canvas>}
</div>

{show && (
  <script>
    import { cardGrid } from '../lib/boundaries'

    const mobileBreak = cardGrid.thresholds[1] ?? 768 // boundary defines where orbs stack
    const isMobileNow = () => window.innerWidth < mobileBreak

    const start = async () => {
      const canvas = document.querySelector('.scene-canvas') as HTMLCanvasElement | null
      if (!canvas) return
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

      // LiteShip device tier gates quality (and skips the heavy path entirely
      // on low-end). data-czap-tier is set by the detect script + GPU upgrade.
      const tier = document.documentElement.getAttribute('data-czap-tier') ?? 'reactive'
      const force = location.search.includes('gl=force') // debug: bypass tier gate (e.g. headless)
      if (!force && (tier === 'static' || tier === 'styled')) return
      const high = tier === 'gpu' || tier === 'animated'
      const quality = high ? { segments: 64, maxDpr: 2 } : { segments: 32, maxDpr: 1.5 }

      const { initScene } = await import('../lib/scene3d')
      const handle = initScene(canvas, { isMobile: isMobileNow(), ...quality })

      // Mood: the sceneMood boundary + AnimatedQuantizer stream eased GLSL
      // values into the scene as you scroll (and cast CSS vars on <html>).
      const { initSceneMood } = await import('../lib/scene-mood')
      const mood = initSceneMood((outputs) => handle.setMood(outputs))

      window.addEventListener('pointermove', (e) => {
        handle.setPointer((e.clientX / window.innerWidth) * 2 - 1, -((e.clientY / window.innerHeight) * 2 - 1))
      }, { passive: true })
      window.addEventListener('resize', () => handle.setMobile(isMobileNow()), { passive: true })
      document.addEventListener('astro:before-swap', () => { mood.dispose(); handle.dispose() }, { once: true })
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true })
    else start()
  </script>
)}

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: -100;
    pointer-events: none;
    /* static fallback shown on low tiers / reduced-motion / before the scene
       mounts. --czap-mood-glow is the sceneMood boundary's CSS cast — on
       tiers where the GLSL target is gated off, the same quantizer still
       breathes through this gradient. */
    background:
      radial-gradient(40% 40% at 78% 24%, color-mix(in srgb, #06b6d4 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 60%),
      radial-gradient(38% 38% at 22% 78%, color-mix(in srgb, #8b5cf6 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 60%),
      var(--bg-primary);
    transition: background 900ms ease;
  }
  .scene-canvas { width: 100%; height: 100%; display: block; }
</style>

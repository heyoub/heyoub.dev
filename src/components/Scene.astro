---
// The WebGL background — now a LiteShip GPU shader cast (no more vanilla
// three.js). A full-screen fragment shader (/shaders/scene.frag) hydrated by
// the `gpu` client directive (booted natively off the data-czap-directive
// marker, like the hero's worker). The sceneMood boundary drives it: scroll →
// blended uniforms via czap:uniform-update (scene-mood.ts), on the RAF spine.
//
// Server omits the canvas for reduced-motion (motion tier 'none'); the gpu
// directive itself also no-ops on static/styled tiers — both leave the CSS
// gradient fallback (which still breathes via the --czap-mood-* cast).
import { satelliteAttrs } from '@czap/astro'
import { sceneMood } from '@/lib/boundaries'
import { MOOD_GLSL, MOOD_STATES } from '@/data/scene-moods'
import { sceneFragIntegrity, sceneWgslIntegrity } from '@/lib/shader-integrity'
import { sceneEntityId } from '@/lib/graph'

const { tiers } = Astro.locals.czap!
const show = tiers.motion !== 'none'

// 0.4.0 secure-by-default: external shaders must pin their content (SRI) or the
// gpu directive refuses to compile them (the "orbs vanished" regression).
const fragIntegrity = await sceneFragIntegrity()
const wgslIntegrity = await sceneWgslIntegrity()

// Per-state GLSL uniform payload — u_-prefixed to match scene.frag's uniforms.
// Carried on the satellite so the inspector shows the active glsl cast; the
// continuous values are streamed by the RAF bridge.
const glslStates = Object.fromEntries(
  MOOD_STATES.map((s) => [s, Object.fromEntries(Object.entries(MOOD_GLSL[s]).map(([k, v]) => [`u_${k}`, v]))]),
)
const { class: satClass, ...satData } = satelliteAttrs({ boundary: sceneMood, directive: 'gpu', glsl: glslStates })
---

<div class="scene" aria-hidden="true">
  {show && (
    <canvas
      class:list={['scene-canvas', satClass]}
      data-czap-shader-type="glsl"
      data-czap-shader-src="/shaders/scene.frag"
      data-czap-shader-integrity={fragIntegrity}
      data-czap-entity={sceneEntityId}
      {...satData}
    ></canvas>
  )}
</div>

{show && (
  /* The net-new WGSL/WebGPU cast is opt-in via ?cast=wgsl. GLSL is the default
     everywhere; WGSL now carries a real vec2 u_resolution (0.6.0 vector uniforms)
     so it runs the same aspect-correct field the GLSL cast does — but it's still
     the demo path: it only engages where WebGPU can ACTUALLY boot a device.
     Runs at parse time (is:inline) so attributes settle before the gpu directive
     (which boots behind a dynamic import) reads them. (preferWebGPU integration
     config is an upstream no-op.) */
  <script is:inline define:vars={{ wgslIntegrity }}>
    (function () {
      var search = location.search
      var canvas = document.querySelector('.scene-canvas')
      if (!canvas) return

      // ?gl=force — flip the documented data-czap-gpu-force hatch so the shader
      // also renders on sub-reactive devices (e.g. demoing on a weak GPU that
      // tiers 'styled'). Synchronous; the gpu directive itself otherwise defers
      // on a low provisional tier and re-boots on czap:detect-ready (0.2.3, F2).
      if (/[?&]gl=force/.test(search)) canvas.setAttribute('data-czap-gpu-force', '')

      // ?cast=wgsl — opt into the WGSL/WebGPU cast, but PROBE first. `'gpu' in
      // navigator` only means the API is EXPOSED, not that a device exists: on
      // Linux Chromium especially, navigator.gpu is present while requestAdapter()
      // returns null (no working backend). Swapping optimistically there forces
      // the WGSL shader with no device → a black canvas, because we'd have swapped
      // AWAY from the GLSL fallback. So request a real adapter+device and only
      // pin WGSL when one actually boots; otherwise keep the GLSL cast (the richer
      // visual anyway), so the link degrades to the orbs instead of going black.
      // The probe (a local call started at parse) resolves before the gpu chunk
      // finishes importing, so the swap wins the boot race on capable devices.
      if (!/[?&]cast=wgsl/.test(search) || !('gpu' in navigator)) return
      ;(async function () {
        try {
          var adapter = await navigator.gpu.requestAdapter()
          if (!adapter) return
          var device = await adapter.requestDevice()
          if (!device) return
          device.destroy() // throwaway capability probe; the directive makes its own
        } catch (e) {
          return // no working WebGPU — keep GLSL, never black
        }
        canvas.setAttribute('data-czap-shader-type', 'wgsl')
        canvas.setAttribute('data-czap-shader-src', '/shaders/scene.wgsl')
        // Swap the SRI pin too, or the gpu directive refuses the wgsl shader
        // (0.4.0 secure-by-default).
        canvas.setAttribute('data-czap-shader-integrity', wgslIntegrity)
      })()
    })()
  </script>
)}

{show && (
  <script>
    import { initSceneMood } from '@/lib/scene-mood'

    const start = (): void => {
      const canvas = document.querySelector<HTMLCanvasElement>('.scene-canvas')
      if (!canvas) return
      // The gpu directive owns the GL context + RAF loop. On a low provisional
      // tier it defers and re-boots itself when the probe settles a GPU-admitting
      // tier (czap:detect-ready — 0.2.3, our finding F2), so capable devices boot
      // with zero consumer polling; genuinely sub-reactive devices keep the CSS
      // .scene gradient. (?gl=force flips data-czap-gpu-force to render anyway.)
      // We own only the scroll → uniform bridge.
      // No astro:before-swap cleanup — this site has no ClientRouter, so the swap
      // event never fires (was dead code); full-page nav discards the scene anyway.
      initSceneMood(canvas)
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true })
    else start()
  </script>
)}

<style>
  .scene {
    position: fixed;
    inset: 0;
    z-index: -100;
    pointer-events: none;
    /* Static fallback shown on low tiers / reduced-motion / before the shader
       mounts. --czap-mood-glow is the sceneMood boundary's CSS cast — on tiers
       where the GLSL target is gated off, the same blend breathes through this
       gradient. */
    background:
      radial-gradient(40% 40% at 78% 24%, color-mix(in srgb, #06b6d4 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 60%),
      radial-gradient(38% 38% at 22% 78%, color-mix(in srgb, #8b5cf6 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 60%),
      var(--bg-primary);
    transition: background 900ms ease;
  }
  .scene-canvas { width: 100%; height: 100%; display: block; }

  /* Phones (< md, breakpoints.js) — stack the two fallback orbs VERTICALLY
     (top-center · bottom-center) to match the shader's portrait layout; the
     diagonal top-right / bottom-left corners get clipped on a narrow screen. This
     gradient is the scene on low / reduced-motion tiers where the canvas is omitted
     (show=false), so it must read on a phone too. Tablets+ keep the diagonal. */
  @media (max-width: 767.98px) {
    .scene {
      background:
        radial-gradient(48% 30% at 50% 19%, color-mix(in srgb, #06b6d4 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 62%),
        radial-gradient(48% 30% at 50% 83%, color-mix(in srgb, #8b5cf6 calc(var(--czap-mood-glow, 0.22) * 55%), transparent), transparent 62%),
        var(--bg-primary);
    }
  }
</style>

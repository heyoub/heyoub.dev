---
import { openToContent as o } from '@/data/content'
---

<section id="services" class="py-[clamp(1.5rem,6vw,6rem)] px-[8vw] bg-gradient-to-br from-accent/[0.03] to-purple/[0.03] border-y border-white/5">
  <div class="flex flex-col items-center gap-8 md:gap-12" data-reveal>
    <div class="text-center">
      <h3 class="font-serif text-[clamp(1.5rem,4vw,2rem)] mb-4">{o.heading}</h3>
      <p class="text-text-secondary font-light text-[clamp(0.95rem,2vw,1.125rem)] max-w-lg mx-auto">{o.description}</p>
    </div>

    <div class="grid czap-grid-3 gap-3 md:gap-4 w-full max-w-5xl" data-reveal-stagger>
      {o.services.map((service) => (
        <div class="p-4 md:p-5 bg-bg-tertiary/50 border border-white/5 hover:border-white/10 transition-all duration-300 border-t-2" style={`border-top-color: var(--${service.accent})`}>
          <h4 class="font-serif text-[clamp(1rem,1.8vw,1.15rem)] mb-2" style={`color: var(--${service.accent})`}>{service.title}</h4>
          <p class="text-text-secondary font-light text-[clamp(0.85rem,1.5vw,0.95rem)] leading-snug">{service.description}</p>
        </div>
      ))}
    </div>

    <div class="flex flex-wrap justify-center gap-2 md:gap-3" data-reveal-stagger>
      {o.roles.map((role, index) => (
        <span class={`font-mono text-[clamp(0.65rem,1.5vw,0.75rem)] tracking-wider px-4 md:px-5 py-2.5 md:py-3 border transition-colors ${index === o.roles.length - 1 ? 'border-accent/10 text-accent/40' : 'border-accent/30 text-accent'}`}>{role}</span>
      ))}
    </div>
  </div>
</section>

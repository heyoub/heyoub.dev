---
import { openToContent as o } from '@/data/content'
---

<section id="services" class="py-[clamp(1.5rem,6vw,6rem)] px-[8vw] bg-gradient-to-br from-accent/[0.03] to-purple/[0.03] border-y border-white/5">
  <div class="opento-stack flex flex-col items-center" data-reveal>
    <div class="text-center">
      <h3 class="font-serif text-[clamp(1.5rem,4vw,2rem)] mb-4">{o.heading}</h3>
      <p class="text-text-secondary font-light text-[clamp(0.95rem,2vw,1.125rem)] max-w-lg mx-auto">{o.description}</p>
    </div>

    <div class="grid czap-grid-3 w-full max-w-5xl" data-reveal-stagger>
      {o.services.map((service) => (
        <div class="bg-bg-tertiary/50 border border-white/5 hover:border-white/10 transition-all duration-300 border-t-2" style={`border-top-color: var(--${service.accent})`}>
          <h4 class="font-serif text-[clamp(1rem,1.8vw,1.15rem)] mb-2" style={`color: var(--${service.accent})`}>{service.title}</h4>
          <p class="text-text-secondary font-light text-[clamp(0.85rem,1.5vw,0.95rem)] leading-snug">{service.description}</p>
        </div>
      ))}
    </div>

    <div class="max-w-2xl mx-auto text-center border-t border-white/10 pt-8" data-reveal>
      <div class="font-mono text-[clamp(0.6rem,1.25vw,0.7rem)] tracking-[0.2em] uppercase text-accent/70 mb-4">{o.hook.label}</div>
      {o.hook.lines.map((line) => (
        <p class="font-light text-[clamp(0.95rem,2vw,1.1rem)] text-text-secondary leading-relaxed mb-3">{line}</p>
      ))}
      <p class="font-serif italic text-[clamp(1.05rem,2.2vw,1.35rem)] text-text-primary leading-snug mt-6">{o.hook.close}</p>
    </div>
  </div>
</section>

---
// The three booking formats, rendered as this site's own primitive: an editor
// window. Same chrome bar, traffic lights, gutter, syntax classes and status
// bar that ContactDecompile already uses — the footer there renders a
// `const links = {...}` object with clickable string values, and booking slots
// are literally the same shape of data. Nothing new is invented here.
//
// Used in two places: inside the booking <dialog> (opened by every CTA) and
// standing alone on /book. The dialog passes its close button into the
// `chrome-action` slot so it lands in the tab position an editor puts it in,
// rather than on top of the traffic lights.
//
// The line numbers are CSS counters on the lines themselves, NOT a parallel
// gutter list. A gutter that counts LOGICAL lines silently desyncs the moment
// a line wraps — the numbers slide up the page while the text does not — and
// these notes wrap at every width worth caring about. A counter cannot drift
// from the thing it is counting.
//
// The three rows are ONE sibling set: key, quoted timing, trailing note. Onsite
// has no fixed duration but still fills the timing slot ("By request") and still
// carries a note, so it is not the member with its own treatment.
import { BOOKING, bookingPath } from '../lib/booking'

interface Props {
  headingId?: string
  /** Rendered at /book/<unknown>, where the page is also a 404. */
  missing?: string
}

const { headingId, missing } = Astro.props

// The key column, derived rather than guessed. A fixed rem min-width cannot
// track a font that is itself a clamp(), and 4.5rem was narrower than
// `session: ` renders — the values were landing 6px out of column, which is the
// one thing a code view must not do. `ch` is the monospace character width, so
// this holds at every size in the clamp, and adding a longer key widens the
// column instead of breaking the alignment.
const keyCols = Math.max(...BOOKING.slots.map((s) => s.key.length)) + 2 // + ": "
---

<div class="booking-window flex flex-col bg-editor-bg border border-editor-border rounded-lg overflow-hidden">
  <!-- chrome -->
  <div role="presentation" class="flex justify-between items-center px-4 py-3 bg-editor-chrome border-b border-editor-border">
    <span class="font-mono text-xs text-text-muted flex items-center gap-2">
      <span class="text-[0.65rem] opacity-60" aria-hidden="true">⟨/⟩</span>booking.ts
      <slot name="chrome-action" />
    </span>
    <div class="flex gap-2 shrink-0 ml-4" aria-hidden="true">
      <span class="w-3 h-3 rounded-full bg-editor-red"></span>
      <span class="w-3 h-3 rounded-full bg-editor-yellow"></span>
      <span class="w-3 h-3 rounded-full bg-editor-green"></span>
    </div>
  </div>

  <!-- source -->
  <div class="booking-code code-block font-mono text-[clamp(0.7rem,1.5vw,0.875rem)] leading-relaxed" style={`--key-cols:${keyCols}ch`}>
    {missing && (
      <>
        <p class="bline"><span class="bline-c"><span class="code-comment code-comment--with-slashes">no such route: /book/{missing}</span></span></p>
        <p class="bline"><span class="bline-c">&nbsp;</span></p>
      </>
    )}
    <h2 class="bline" id={headingId}>
      <span class="bline-c"><span class="code-comment code-comment--with-slashes">{BOOKING.heading.replace(/\.$/, '').toLowerCase()}</span></span>
    </h2>
    <p class="bline"><span class="bline-c"><span class="code-comment code-comment--with-slashes">{BOOKING.body}</span></span></p>
    <p class="bline"><span class="bline-c">&nbsp;</span></p>
    <p class="bline">
      <span class="bline-c">
        <span class="code-keyword">const</span> <span class="code-variable">slots</span><span class="code-punctuation"> = {'{'}</span>
      </span>
    </p>

    {BOOKING.slots.map((slot, i) => (
      <a class="bline booking-row code-link" href={bookingPath(slot.key)}>
        <span class="bline-c bline-c--indent code-property booking-row-inner">
          <span class="code-key">{slot.key}</span>
          <span class="code-string">{slot.timing}</span>
          <span class="code-punctuation" aria-hidden="true">{i < BOOKING.slots.length - 1 ? ',' : ''}</span>
          <span class="code-comment code-comment--with-slashes booking-note">{slot.note}</span>
        </span>
      </a>
    ))}

    <p class="bline"><span class="bline-c"><span class="code-punctuation">{'};'}</span></span></p>
    <p class="bline"><span class="bline-c">&nbsp;</span></p>
    <p class="bline"><span class="bline-c"><span class="code-comment code-comment--with-slashes">pick one</span></span></p>
  </div>

  <!-- status -->
  <div role="status" class="flex justify-between items-center px-4 py-3 bg-editor-chrome border-t border-editor-border">
    <div class="flex items-center gap-3 text-editor-gray-light">
      <span class="w-2 h-2 rounded-full bg-green animate-pulse" aria-hidden="true"></span>
      <span class="font-mono text-xs">open to work</span>
    </div>
    <small class="font-mono text-[0.65rem] tracking-wider text-editor-gray">{BOOKING.slots.length} formats</small>
  </div>
</div>

<style>
  .booking-code {
    counter-reset: bline;
    padding-block: 1.25rem;
    padding-right: 1rem;
  }

  /* Number and content are ONE grid row, so a wrapped line keeps its number at
     the top of its own block instead of the two lists sliding apart. The number
     cell also draws its own segment of the gutter rule; the segments abut into
     a continuous line because the rows are contiguous. */
  .bline {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 1rem;
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }
  .bline::before {
    counter-increment: bline;
    content: counter(bline);
    color: var(--color-editor-gray, #6e7681);
    text-align: right;
    padding-right: 0.75rem;
    border-right: 1px solid var(--color-editor-border, #30363d);
    user-select: none;
  }
  /* Every .bline has exactly ONE content child. With two grid columns, a line
     of several spans would reflow its later spans back under the number. */
  .bline-c {
    min-width: 0;
  }
  /* The nested object body's indentation, expressed on the line's content
     rather than on a wrapper element — a wrapper would take the rows out of the
     numbered grid. */
  .bline-c--indent {
    padding-left: 1rem;
  }

  /* An anchor standing in for a code line: the grid gives it the number column,
     and its content is a baseline-aligned wrapping row. */
  .booking-row {
    text-decoration: none;
  }
  /* No flex declarations here: the row carries .code-property, the global
     primitive that already supplies the baseline-aligned wrapping row AND the
     `: ` after the key. Reimplementing the row by hand is what dropped the
     colon — the separator only exists as `.code-property .code-key::after`. */
  .booking-row-inner {
    width: 100%;
  }
  .booking-row .code-key {
    min-width: var(--key-cols, 9ch);
  }
  .booking-note {
    margin-left: 0.75rem;
  }
</style>

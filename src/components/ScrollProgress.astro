---
const DOTS = [
  { top: '12%', right: '1.2rem', size: 3 },
  { top: '28%', right: '0.8rem', size: 2 },
  { top: '44%', right: '1.5rem', size: 2.5 },
  { top: '60%', right: '0.6rem', size: 2 },
  { top: '76%', right: '1.3rem', size: 3 },
  { top: '90%', right: '0.9rem', size: 2 },
]
---

<div class="sp fixed top-0 right-0 bottom-0 z-[100] pointer-events-none" data-scroll-progress style="opacity:0;transition:opacity .3s">
  <div class="sp-counter absolute top-4 right-3 font-mono text-[9px] tracking-[0.2em] flex items-center gap-2">
    <span class="text-text-muted/40">SCROLL</span>
    <span class="text-accent/70 tabular-nums" data-sp-pct>000</span>
    <span class="text-text-muted/40">%</span>
  </div>
  {DOTS.map((dot) => (
    <div class="sp-dot absolute rounded-full" data-pos={parseFloat(dot.top) / 100}
      style={`top:${dot.top}; right:${dot.right}; width:${dot.size}px; height:${dot.size}px; background-color: var(--accent); opacity:0.1; transition: opacity .3s, transform .3s, box-shadow .3s`}></div>
  ))}
</div>

<script>
  import { Boundary } from '@czap/core'
  import { sceneMood } from '@/lib/boundaries'

  const root = document.querySelector<HTMLElement>('[data-scroll-progress]')
  const pct = document.querySelector<HTMLElement>('[data-sp-pct]')
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.sp-dot'))

  // The rail is a little map of the scene's mood arc: each dot sits at a scroll
  // depth, so tint it by the mood the sceneMood boundary resolves to THERE. One
  // batch eval of N positions against one boundary — Boundary.evaluateBatch
  // routes through the Rust WASM kernel (WASMDispatch) when it's loaded, with a
  // bit-identical JS fallback before then. Re-run on czap:wasm-ready so the
  // kernel path genuinely executes once the module lands (no visible change —
  // the point is to USE it, and the numbers are equal by construction).
  // arrival → thesis → work → sendoff : calm cyan, cooler blue, kinetic violet, warm sendoff.
  const MOOD_COLORS = ['34,211,238', '94,179,240', '168,85,247', '240,168,104']
  const positions = dots.map((d) => parseFloat(d.dataset.pos || '0')) // scroll.progress 0..1 (0.3.0+)
  let moodRGB: string[] = dots.map(() => MOOD_COLORS[0])
  const computeMoods = (): void => {
    const idx = Boundary.evaluateBatch(sceneMood, positions) // Uint32Array of mood indices
    moodRGB = Array.from(idx, (i) => MOOD_COLORS[i] ?? MOOD_COLORS[0])
    for (let i = 0; i < dots.length; i++) dots[i].style.backgroundColor = `rgb(${moodRGB[i]})`
  }
  computeMoods()
  document.addEventListener('czap:wasm-ready', computeMoods) // re-run on the Rust kernel

  let ticking = false
  const paint = () => {
    ticking = false
    const max = document.documentElement.scrollHeight - window.innerHeight
    const v = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0
    if (root) root.style.opacity = v > 0.02 && v < 0.99 ? '1' : '0'
    if (pct) pct.textContent = Math.round(v * 100).toString().padStart(3, '0')
    for (let i = 0; i < dots.length; i++) {
      const d = dots[i]
      const p = parseFloat(d.dataset.pos || '0')
      const dist = Math.abs(v - p)
      d.style.opacity = dist < 0.08 ? '0.9' : v > p ? '0.4' : '0.1'
      d.style.transform = dist < 0.08 ? 'scale(1.4)' : 'scale(1)'
      d.style.boxShadow = dist < 0.08 ? `0 0 8px rgba(${moodRGB[i]},0.6)` : 'none'
    }
  }
  const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(paint) } }
  window.addEventListener('scroll', onScroll, { passive: true })
  paint()
</script>

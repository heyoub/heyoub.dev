---
import { satelliteAttrs, resolveInitialStateFallback } from '@czap/astro'
import { heroLayout } from '@/lib/boundaries'
import { heroContent as h } from '@/data/content'

const { tier } = Astro.locals.czap
const HIGH = tier.cap === 'gpu' || tier.cap === 'animated'

// Spread the heroLayout boundary onto the section: data-czap-boundary +
// the initial bearing. The client evaluator updates data-czap-state live;
// the CSS below recomposes per state (stacked / split / cinematic).
const sat = satelliteAttrs({
  boundary: heroLayout,
  initialState: resolveInitialStateFallback(heroLayout),
})
---

<section {...sat} class={`${sat.class} hero`} id="top">
  <div class="content">
    <h1 class="name">
      {h.name.first} <em>{h.name.last}</em>
    </h1>
    <p class="label mono">{h.label}</p>
    <p class="tagline measure">
      {h.tagline.before} <strong>{h.tagline.emphasis}</strong>{h.tagline.after}
    </p>
    <blockquote class="quote measure">
      {h.quote.regular} <span class="c-accent">{h.quote.emphasis}</span>
    </blockquote>
    <div class="actions">
      <a href={h.cta.href} class="book" target="_blank" rel="noopener">
        {h.cta.label} <strong>{h.cta.action}</strong> →
      </a>
      <span class={`rig mono ${HIGH ? 'rig--full' : 'rig--lean'}`}>
        {HIGH ? `full rig · ${tier.cap}` : `lean rig · ${tier.cap}`}
      </span>
    </div>
  </div>

  <div class="portrait">
    <img src={h.photo.src} alt={h.photo.alt} width="520" height="640" loading="eager" />
  </div>

  <span class="scroll-hint mono">{h.scrollHint} ↓</span>
</section>

<style>
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100svh;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2rem, 6vw, 4rem);
    padding: 7rem var(--gutter) 4rem;
  }
  /* split / cinematic bearings open a second column for the portrait */
  .hero[data-czap-state='split'],
  .hero[data-czap-state='cinematic'] {
    grid-template-columns: 1.2fr 0.8fr;
  }
  .hero[data-czap-state='stacked'] .portrait { display: none; }

  .name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 9vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .name em { font-style: italic; color: var(--muted); }
  .hero[data-czap-state='cinematic'] .name { font-size: clamp(5rem, 8vw, 8rem); }

  .label { font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.75rem; }
  .tagline { font-size: clamp(1.05rem, 2.4vw, 1.4rem); color: var(--muted); margin-bottom: 1.75rem; }
  .tagline strong { color: var(--text); font-weight: 500; }
  .quote {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--muted);
    font-style: italic;
    border-left: 2px solid color-mix(in srgb, var(--accent) 40%, transparent);
    padding-left: 1rem;
    margin-bottom: 2rem;
  }
  .actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .book {
    display: inline-flex;
    gap: 0.4rem;
    padding: 0.7rem 1.3rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .book:hover { transform: translateY(-2px); box-shadow: 0 8px 30px var(--accent-glow); }
  .rig { font-size: 0.65rem; letter-spacing: 0.18em; text-transform: uppercase; padding: 0.4rem 0.7rem; border-radius: 999px; border: 1px solid currentColor; }
  .rig--full { color: var(--accent); }
  .rig--lean { color: var(--purple); }

  .portrait img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 60px rgba(0,0,0,0.5));
  }

  .scroll-hint {
    position: absolute;
    bottom: 1.5rem; left: var(--gutter);
    font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint);
  }
</style>

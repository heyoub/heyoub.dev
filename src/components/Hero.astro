---
import { satelliteAttrs, resolveInitialState } from '@czap/astro'
import type { CapTier } from '@czap/core'
import { heroLayout } from '@/lib/boundaries'
import { heroContent as h } from '@/data/content'

// The hero's ENTIRE responsive layer is LiteShip @quantize now — heroLayout
// drives the columns (split/cinematic), heroChrome the tablet chrome (768) — so
// there is zero Tailwind md:/lg: on the hero (src/styles/layout.quantize.css).
// The heroLayout boundary is still carried on the section so it also feeds u_state.
// Merge the satellite class into ours; spread only the data-czap-* attrs so
// the explicit class (with all the layout utilities) isn't clobbered.
// directive: 'worker' → since 0.1.5 the boot scanner activates the worker
// client directive natively off the data-czap-directive marker (evaluates
// the boundary over a SharedArrayBuffer ring under crossOriginIsolated);
// the manual entrypoint invocation this site shipped against 0.1.4 is gone.
// resolveInitialState (NOT the first-state resolveInitialStateFallback): the
// tuck animation below keys off data-czap-state, so the SSR'd state is now
// VISUAL — the fallback's 'stacked' guess left desktop first paint with the
// tuck unarmed until the worker booted (and forever with JS off). The request-
// aware resolver reads UA/Client Hints + the middleware-detected tier, so a
// desktop UA SSRs 'split' and the tuck is armed pre-JS. (liteship-auditor P1)
const { class: satClass, ...satData } = satelliteAttrs({
  boundary: heroLayout,
  initialState: resolveInitialState(heroLayout, {
    userAgent: Astro.request.headers.get('user-agent') ?? '',
    clientHints: Object.fromEntries(Astro.request.headers),
    // Cast: middleware.d.ts types tiers as Record<CapAxis, string>, but the
    // tier axis only ever holds CapTier values — upstream typing gap (0.8.0).
    detectedCapTier: Astro.locals.czap?.tiers.tier as CapTier | undefined,
  }),
  directive: 'worker',
})
---

<section id="hero-satellite" class={`${satClass} czap-hero-grid relative min-h-svh grid items-center px-[8vw] overflow-hidden`} {...satData}>
  <!-- Content -->
  <div class="hero-content hero-copy">
    <h1 class="font-serif text-[clamp(2.5rem,8vw,7rem)] font-normal leading-[0.95] tracking-tight animate-fadeInUp" style="animation-delay:0.4s">
      {h.name.first} <span class="italic text-text-secondary">{h.name.last}</span>
    </h1>

    <div class="hero-eyebrow font-mono text-[clamp(0.65rem,1.5vw,0.75rem)] tracking-[0.3em] uppercase text-accent animate-fadeInUp" style="animation-delay:0.2s">
      {h.label}
    </div>

    <p class="text-[clamp(1rem,2.5vw,1.25rem)] font-light text-text-secondary leading-relaxed animate-fadeInUp" style="animation-delay:0.6s">
      {h.tagline.before}{' '}
      <strong class="text-text-primary font-medium">{h.tagline.emphasis}</strong>
      {h.tagline.after}
    </p>

    <!-- Quote full-width, squares on their own wrapping row: three same-size
         squares + the quote can't share one grid row (copy column is ~600px at
         1440, three 160px squares + gaps leave ~50px for the quote — and the old
         rigid grid already clipped the FBF square under overflow-hidden at 375). -->
    <div class="max-w-2xl animate-fadeInUp" style="animation-delay:0.8s">
      <!-- Quote -->
      <div class="flex items-center gap-4 border-l-2 border-accent/30 pl-4 mb-6">
        <p class="text-[clamp(0.95rem,2vw,1.125rem)] font-light text-text-secondary">
          {h.quote.regular}{' '}<span class="text-text-primary italic">{h.quote.emphasis}</span>
        </p>
      </div>

      <!-- CTA squares. The regime-switching props (row gap, cell flex/padding,
           square width) live in the @quantize layer (layout.quantize.css): base
           (stacked/compact) = three equal squares filling ONE row; from
           heroChrome.expanded (768) = the fixed right-aligned squares. -->
      <div class="hero-ctas flex justify-end">
        <!-- Book a Call square -->
        <div class="hero-cta-cell flex items-center justify-center">
          <a href={h.cta.href} class="hero-cta aspect-square bg-accent/10 border border-accent/30 hover:bg-accent hover:border-accent hover:text-bg-primary cta-btn flex flex-col items-center justify-center gap-2 group touch-target cta-glow focus-ring press-effect tap-highlight">
            <span class="font-mono text-[clamp(0.65rem,1.5vw,0.75rem)] tracking-wider uppercase">{h.cta.label}</span>
            <span class="font-serif text-[clamp(1.5rem,3vw,2rem)] text-accent group-hover:text-bg-primary transition-colors">{h.cta.action}</span>
          </a>
        </div>

        <!-- FBF square -->
        <div class="hero-cta-cell flex items-center justify-center">
          <a href="https://freebatteryfactory.com" target="_blank" rel="noopener noreferrer" class="hero-cta aspect-square bg-purple/10 border border-purple/30 hover:bg-purple hover:border-purple hover:text-bg-primary cta-btn flex flex-col items-center justify-center gap-2 group touch-target focus-ring press-effect tap-highlight">
            <span class="font-mono text-[clamp(0.65rem,1.5vw,0.75rem)] tracking-wider uppercase">the</span>
            <span class="font-serif text-[clamp(1.5rem,3vw,2rem)] text-purple group-hover:text-bg-primary transition-colors">FBF</span>
          </a>
        </div>

        <!-- Résumé square — warm gold, the same #fbbf24 as the scene orbs' amber;
             same PDF the footer links, kept there too -->
        <div class="hero-cta-cell flex items-center justify-center">
          <a href="/Eassa_Ayoub_Resume.pdf" target="_blank" rel="noopener noreferrer" class="hero-cta aspect-square bg-warm/10 border border-warm/30 hover:bg-warm hover:border-warm hover:text-bg-primary cta-btn flex flex-col items-center justify-center gap-2 group touch-target focus-ring press-effect tap-highlight">
            <span class="font-mono text-[clamp(0.65rem,1.5vw,0.75rem)] tracking-wider uppercase">my</span>
            <span class="font-serif text-[clamp(1.5rem,3vw,2rem)] text-warm group-hover:text-bg-primary transition-colors">Résumé</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Photo. animate-fadeInUp lives on the INNER frame, not the .hero-content
       figure: the tuck rule above sets `animation` on .hero-content with higher
       specificity, so an entrance animation on the same element would be
       replaced in split/cinematic (now armed at SSR) — decoupled elements keep
       both the entrance fade and the scroll tuck. -->
  <div class="hero-content hero-figure flex justify-center items-center">
    <div class="w-full max-w-[380px] aspect-[380/480] bg-gradient-to-br from-bg-tertiary to-bg-secondary border border-white/[0.08] relative overflow-hidden animate-fadeInUp" style="animation-delay:0.5s">
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-cyan-500 to-purple-500"></div>
      <picture class="contents">
        <source srcset="/assets/headshot.avif" type="image/avif" />
        <source srcset="/assets/headshot.webp" type="image/webp" />
        <img src={h.photo.src} alt={h.photo.alt} class="w-full h-full object-cover object-top" loading="eager" fetchpriority="high" decoding="async" width={380} height={480} />
      </picture>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-hint absolute font-mono text-[clamp(0.6rem,1.25vw,0.7rem)] tracking-widest text-text-muted" aria-hidden="true">
    <div class="hint-inner flex items-center">
      <div class="from-accent/50 via-accent to-transparent hint-line"></div>
      <span class="hint-text">{h.scrollHint}</span>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      /* Hero content tucks DOWN + fades + scales from the FIRST pixel of scroll —
         the pre-LiteShip framer-motion parallax (useScroll offset start-start:
         contentY 0→250, opacity 1→0, scale 1→0.95 over one viewport). Driven off
         scroll(root block) — the real scroller, proven live with Lenis below — so
         it responds immediately, instead of the old view()/exit range that only
         fired once the hero was already leaving (read as static while reading).
         Keyed to the heroLayout boundary state (the satellite's data-czap-state,
         live-updated by the worker directive): only split/cinematic tuck. In the
         stacked regime the copy + CTA squares START below the fold, so a fade
         tied to scroll 0→100vh dims them while the user is still scrolling TO
         them — the "hero fades before you can tap the buttons" phone bug. */
      #hero-satellite[data-czap-state='split'] .hero-content,
      #hero-satellite[data-czap-state='cinematic'] .hero-content {
        animation: hero-tuck linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 100vh;
      }
      /* stacked: the hero still says goodbye, but only AFTER the reach — same
         scroll(root) timeline, range shifted past the first viewport (the copy
         + CTAs start below the fold on phones, so a 0-start fade dims them on
         the way TO them). Pure opacity: the tuck's downward translate was the
         other half of the reach problem. NOT view()-based: #hero-satellite is
         overflow-hidden, i.e. a scroll container, so a view() timeline in here
         would track the section's own never-scrolling scrollport and freeze. */
      #hero-satellite[data-czap-state='stacked'] .hero-content {
        animation: hero-fade-late linear both;
        animation-timeline: scroll(root block);
        animation-range: 100vh 200vh;
      }
      /* The scroll cue drifts up + fades in concert (over the first ~70vh). On the
         inner wrapper so it doesn't clobber the hint's translate-x centering. */
      .hint-inner {
        animation: hint-drift linear both;
        animation-timeline: scroll(root block);
        animation-range: 0 70vh;
      }
    }
  }
  /* Keyframe %s map to scroll progress (0→100vh). Mirrors the framer curve:
     contentY [0,.5,1]→[0,100,250], opacity [0,.4,.7,1]→[1,.8,.3,0], scale 1→0.95. */
  @keyframes hero-tuck {
    0%   { transform: translateY(0)     scale(1);     opacity: 1; }
    40%  { transform: translateY(80px)  scale(0.98);  opacity: 0.8; }
    70%  { transform: translateY(160px) scale(0.965); opacity: 0.3; }
    100% { transform: translateY(250px) scale(0.95);  opacity: 0; }
  }
  @keyframes hint-drift { to { transform: translateY(-70px); opacity: 0; } }
  @keyframes hero-fade-late { to { opacity: 0; } }

  /* The cue breathes as ONE pulse — line + text on the same 2.4s curve — and
     nudges DOWN in sync (the universal "scroll here" signal) so someone hunting
     for where to go catches it. The feathered accent halo fades in/out around
     the glyphs (a soft outline that breathes, never a flash). The drift on
     .hint-inner fades the whole cue out once scrolling starts, so this idle
     beacon only plays at the top where the wayfinding question is asked. */
  @media (prefers-reduced-motion: no-preference) {
    .hint-line { animation: hint-pulse 2.4s ease-in-out infinite; }
    .hint-text { animation: hint-breathe 2.4s ease-in-out infinite; }
  }
  @keyframes hint-pulse {
    0%, 100% { transform: translateY(0);   opacity: 0.5; }
    50%      { transform: translateY(4px); opacity: 1; }
  }
  @keyframes hint-breathe {
    0%, 100% { transform: translateY(0);   text-shadow: 0 0 5px rgba(34, 211, 238, 0); opacity: 0.62; }
    50%      { transform: translateY(4px); text-shadow: 0 0 10px rgba(34, 211, 238, 0.5), 0 0 20px rgba(34, 211, 238, 0.22); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .animate-fadeInUp { animation: none !important; } }
</style>


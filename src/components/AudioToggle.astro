<button class="audio-toggle mono" type="button" aria-pressed="false" data-audio-toggle>
  <span class="ring" aria-hidden="true"></span>
  <span class="txt">ambient</span>
</button>

<script>
  import { createAudioField } from '../lib/audio-field'

  const btn = document.querySelector<HTMLButtonElement>('[data-audio-toggle]')
  if (btn) {
    const field = createAudioField()
    btn.addEventListener('click', async () => {
      btn.disabled = true
      try {
        const on = await field.toggle()
        btn.setAttribute('aria-pressed', String(on))
        btn.classList.toggle('on', on)
        btn.querySelector('.txt')!.textContent = on ? 'ambient · on' : 'ambient'
      } catch {
        btn.querySelector('.txt')!.textContent = 'audio blocked'
      } finally {
        btn.disabled = false
      }
    })
  }
</script>

<style>
  .audio-toggle {
    position: fixed;
    bottom: 1.25rem; right: 1.25rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(10px);
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .audio-toggle:hover { color: var(--text); transform: translateY(-2px); }
  .audio-toggle:disabled { opacity: 0.5; cursor: progress; }
  .ring {
    width: 11px; height: 11px;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    transition: all 0.2s;
  }
  /* When on, the dot fills + pulses in time with the live audio level
     (the same --czap-audio the shader reads). */
  .audio-toggle.on { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 50%, transparent); }
  .audio-toggle.on .ring {
    background: var(--accent);
    box-shadow: 0 0 calc(2px + var(--czap-audio, 0) * 16px) var(--accent);
    transform: scale(calc(1 + var(--czap-audio, 0) * 0.6));
  }
  @media (prefers-reduced-motion: reduce) {
    .audio-toggle.on .ring { transform: none; }
  }
</style>

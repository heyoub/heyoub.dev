---
import { projectManifest } from '@/data/manifest'
import { contactConfig } from '@/data/footer'

const gitProjects = projectManifest.filter((p) => p.gitUrl)
---

<nav
  class="czap-nav fixed top-0 left-0 right-0 z-50 px-6 md:px-8 py-4 md:py-6 flex justify-between items-center transition-[opacity,transform] duration-300"
  style="background: linear-gradient(to bottom, var(--bg-primary) 0%, transparent 100%);"
>
  <a href="#" data-scroll="#" class="font-mono text-xs md:text-sm tracking-widest text-text-secondary hover:text-accent transition-colors">HEYOUB.DEV</a>

  <!-- Desktop -->
  <div class="hidden md:flex gap-10">
    <div class="nav-drop relative">
      <button class="font-mono text-xs tracking-[0.15em] uppercase text-text-muted hover:text-accent transition-colors" aria-haspopup="true" aria-expanded="false">Git</button>
      <div class="nav-menu absolute top-full right-0 mt-2 min-w-[200px] bg-bg-tertiary border border-white/10 py-2 backdrop-blur-xl">
        {gitProjects.map((p) => (
          <a href={p.gitUrl} target="_blank" rel="noopener noreferrer" class="block px-4 py-2 font-mono text-xs text-text-secondary hover:bg-accent/10 hover:text-accent transition-colors">{p.name}</a>
        ))}
      </div>
    </div>

    <div class="nav-drop relative">
      <button class="font-mono text-xs tracking-[0.15em] uppercase text-text-muted hover:text-accent transition-colors" aria-haspopup="true" aria-expanded="false">Projects</button>
      <div class="nav-menu absolute top-full right-0 mt-2 min-w-[200px] bg-bg-tertiary border border-white/10 py-2 backdrop-blur-xl">
        {projectManifest.map((p) => (
          <button data-scroll="#work" class="block w-full text-left px-4 py-2 font-mono text-xs text-text-secondary hover:bg-accent/10 hover:text-accent transition-colors">{p.name}</button>
        ))}
      </div>
    </div>

    <div class="nav-drop relative">
      <button class="font-mono text-xs tracking-[0.15em] uppercase text-text-muted hover:text-accent transition-colors" aria-haspopup="true" aria-expanded="false">Contact</button>
      <div class="nav-menu absolute top-full right-0 mt-2 min-w-[200px] bg-bg-tertiary border border-white/10 py-2 backdrop-blur-xl">
        <button data-scroll="#footer" class="block w-full text-left px-4 py-2 font-mono text-xs text-text-secondary hover:bg-accent/10 hover:text-accent transition-colors">View Contact Info</button>
        <div class="border-t border-white/5 mt-1 pt-1"></div>
        {contactConfig.links.map((link) => (
          <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} class="block px-4 py-2 font-mono text-xs text-text-secondary hover:bg-accent/10 hover:text-accent transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>

  <!-- Mobile hamburger -->
  <button data-menu-open class="md:hidden w-12 h-12 flex flex-col items-center justify-center gap-1.5 text-text-secondary hover:text-accent transition-colors touch-target focus-ring press-effect tap-highlight" aria-label="Open menu">
    <span class="w-6 h-0.5 bg-current"></span>
    <span class="w-6 h-0.5 bg-current"></span>
    <span class="w-6 h-0.5 bg-current"></span>
  </button>
</nav>

<!-- Mobile menu overlay -->
<div data-menu class="fixed inset-0 z-[60] hidden flex-col bg-bg-primary/95 backdrop-blur-xl p-8">
  <div class="flex justify-end">
    <button data-menu-close class="w-12 h-12 text-text-secondary hover:text-accent text-2xl" aria-label="Close menu">✕</button>
  </div>
  <div class="flex flex-col gap-6 mt-8 font-mono">
    {projectManifest.map((p) => (
      <button data-scroll="#work" class="text-left text-lg text-text-secondary hover:text-accent transition-colors">{p.name}</button>
    ))}
    <button data-scroll="#footer" class="text-left text-lg text-text-secondary hover:text-accent transition-colors">Contact</button>
    {contactConfig.links.map((link) => (
      <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} class="text-lg text-text-secondary hover:text-accent transition-colors">{link.label}</a>
    ))}
  </div>
</div>

<style>
  .nav-menu { opacity: 0; visibility: hidden; transform: translateY(-10px); transition: opacity 0.2s, transform 0.2s, visibility 0.2s; }
  .nav-drop:hover .nav-menu, .nav-drop:focus-within .nav-menu { opacity: 1; visibility: visible; transform: translateY(0); }
  .czap-nav.is-hidden { opacity: 0; transform: translateY(-20px); }
</style>

<script>
  // smooth scroll (works alongside Lenis)
  const scrollTo = (target: string, offset = -100) => {
    const el = target === '#' ? document.body : document.querySelector(target)
    if (!el) return
    const top = el.getBoundingClientRect().top + window.scrollY + offset
    window.scrollTo({ top, behavior: 'smooth' })
  }
  // The desktop dropdowns open on hover OR keyboard focus (the CSS above uses
  // both :hover and :focus-within). The buttons advertise aria-haspopup, so a
  // screen reader announces "has popup" — but without aria-expanded it is never
  // told whether the popup is currently showing, which is the half that says
  // whether Tab will walk into the menu items or straight past them.
  //
  // Driven from the same two conditions the CSS uses, so the announced state and
  // the painted state cannot disagree. Deliberately NOT a boundary: this is
  // pointer/focus state. LiteShip types a `pointer` signal source, but it has
  // no live runtime producer in 0.10.0 — readSignalValue returns undefined for
  // it, so a boundary wired to pointer.* would be frozen and never
  // re-evaluate. Hover and focus therefore stay ordinary DOM events. (An
  // earlier version of this comment claimed the vocabulary was only viewport
  // width and scroll progress; it is seven source types, of which viewport,
  // scroll and audio are the live ones.)
  document.querySelectorAll<HTMLElement>('.nav-drop').forEach((drop) => {
    const button = drop.querySelector<HTMLElement>('[aria-haspopup]')
    if (!button) return
    let hovered = false
    let focused = false
    const sync = (): void =>
      button.setAttribute('aria-expanded', hovered || focused ? 'true' : 'false')
    drop.addEventListener('mouseenter', () => { hovered = true; sync() })
    drop.addEventListener('mouseleave', () => { hovered = false; sync() })
    drop.addEventListener('focusin', () => { focused = true; sync() })
    drop.addEventListener('focusout', (e) => {
      // focusout fires BEFORE the next element takes focus; relatedTarget is
      // where focus is going, so moving between two items inside the same menu
      // keeps it open rather than flickering closed.
      focused = drop.contains((e as FocusEvent).relatedTarget as Node | null)
      sync()
    })
  })

  const menu = document.querySelector<HTMLElement>('[data-menu]')
  const closeMenu = () => { menu?.classList.add('hidden'); menu?.classList.remove('flex') }
  // Nav links scroll to their section (top gets 0 offset, sections a small one) and
  // close the mobile menu. The footer has no tabs to dispatch anymore.
  document.querySelectorAll<HTMLElement>('[data-scroll]').forEach((a) =>
    a.addEventListener('click', (e) => { e.preventDefault(); scrollTo(a.dataset.scroll!, a.dataset.scroll === '#' ? 0 : -20); closeMenu() }),
  )
  // mobile menu
  document.querySelector('[data-menu-open]')?.addEventListener('click', () => { menu?.classList.remove('hidden'); menu?.classList.add('flex') })
  document.querySelector('[data-menu-close]')?.addEventListener('click', () => { menu?.classList.add('hidden'); menu?.classList.remove('flex') })
  // hide-on-scroll-down
  const nav = document.querySelector<HTMLElement>('.czap-nav')
  let lastY = 0
  window.addEventListener('scroll', () => {
    const y = window.scrollY
    if (y < 50) { nav?.classList.remove('is-hidden'); lastY = y; return }
    if (Math.abs(y - lastY) > 10) { nav?.classList.toggle('is-hidden', y > lastY); lastY = y }
  }, { passive: true })
</script>

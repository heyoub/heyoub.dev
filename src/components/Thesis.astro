---
import { coreThesisContent as t, stackPyramid } from '@/data/content'
---

<section class="thesis wrap" id="thesis">
  <p class="kicker reveal">{t.hook}</p>
  <h2 class="headline measure reveal">
    {t.headline.regular} <em class="c-accent">{t.headline.emphasis}</em>
  </h2>

  <div class="problem reveal">
    <p class="hook">{t.problem.hook}</p>
    {t.problem.narrative.map((n) => <p class="narr">{n}</p>)}
    <p class="def">
      <span class="mono c-purple">{t.problem.definition.term}</span> — {t.problem.definition.meaning}
    </p>
  </div>

  <dl class="stats reveal">
    {t.problem.stats.map((s) => (
      <div class="stat">
        <dt class={`c-${s.accent}`}>{s.value}</dt>
        <dd>{s.description}</dd>
      </div>
    ))}
  </dl>

  <p class="truth measure reveal">
    {t.universalTruth.before} <strong class="c-accent">{t.universalTruth.emphasis}</strong> {t.universalTruth.after}
  </p>

  <div class="stack reveal">
    <p class="mono c-faint stack-label">{t.techStackLabel} — metal → intelligence</p>
    {stackPyramid.map((layer) => (
      <div class="layer">
        <span class="layer-label mono">{layer.label}<small>{layer.hint}</small></span>
        <span class="techs">
          {layer.techs.map((tech) => <span class={`tech c-${tech.color}`}>{tech.name}</span>)}
        </span>
      </div>
    ))}
  </div>
</section>

<style>
  .thesis { position: relative; z-index: 2; padding-block: var(--section-y); }
  .headline { font-family: var(--font-serif); font-size: clamp(1.9rem, 5vw, 3.4rem); line-height: 1.1; margin: 1rem 0 2.5rem; }
  .headline em { font-style: italic; }
  .problem { max-width: 44rem; margin-bottom: 2.5rem; }
  .hook { font-size: 1.2rem; color: var(--text); margin-bottom: 0.75rem; }
  .narr { color: var(--muted); margin-bottom: 0.5rem; }
  .def { margin-top: 1.25rem; font-size: 0.95rem; color: var(--muted); }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1px; background: color-mix(in srgb, var(--text) 8%, transparent); border: 1px solid color-mix(in srgb, var(--text) 8%, transparent); border-radius: 0.6rem; overflow: hidden; margin-bottom: 2.5rem; }
  .stat { background: var(--bg); padding: 1.5rem 1.25rem; }
  .stat dt { font-family: var(--font-serif); font-size: 1.8rem; font-style: italic; margin-bottom: 0.4rem; }
  .stat dd { font-size: 0.88rem; color: var(--muted); }

  .truth { font-size: clamp(1.1rem, 2.6vw, 1.5rem); color: var(--muted); margin-bottom: 3rem; }
  .truth strong { font-weight: 500; }

  .stack { border-top: 1px solid color-mix(in srgb, var(--text) 6%, transparent); padding-top: 1.5rem; }
  .stack-label { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1rem; }
  .layer { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1.25rem; padding: 0.6rem 0; border-bottom: 1px dashed color-mix(in srgb, var(--text) 7%, transparent); }
  .layer-label { font-size: 0.72rem; letter-spacing: 0.15em; min-width: 9rem; color: var(--text); }
  .layer-label small { display: block; color: var(--faint); letter-spacing: 0.05em; text-transform: none; font-size: 0.62rem; margin-top: 0.15rem; }
  .techs { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .tech { font-family: var(--font-mono); font-size: 0.82rem; }
</style>

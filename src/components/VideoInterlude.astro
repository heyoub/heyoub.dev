---
import { momentContent } from '@/data/content'

interface Props {
  src: string
  height?: string
  overlay?: 'gradient' | 'dark' | 'none'
  class?: string
  lite?: boolean
}
const { src, height = '60vh', overlay = 'gradient', class: className = '', lite = false } = Astro.props
// AV1/WebM primary (modern browsers), the .mp4 prop is the H.264 fallback.
const webm = src.replace(/\.mp4$/, '.webm')

// Precompute each narrative line's treatment (avoids `<`/`<=` inside JSX,
// which Astro's compiler misparses).
const lineItems = momentContent.lines.map((line, i) => {
  if (line === '') return { gap: true, cls: '', text: '' }
  let cls = 'font-serif text-[clamp(1.3rem,3vw,1.6rem)] text-white leading-snug'
  if (i === 0) cls = 'font-mono text-[clamp(0.7rem,1.5vw,0.85rem)] tracking-[0.2em] uppercase text-accent/80'
  else if (i === 1 || i === 2) cls = 'font-light text-[clamp(0.95rem,2vw,1.1rem)] text-white/70 leading-relaxed'
  else if (i === 3) cls = 'font-serif text-[clamp(1.1rem,2.2vw,1.3rem)] text-white/90 italic'
  else if (i === 5) cls = 'font-serif text-[clamp(1.15rem,2.5vw,1.4rem)] text-white/90 leading-snug'
  return { gap: false, cls, text: line }
})
---

<div class={`vi relative overflow-hidden ${className}`} style={`height:${height}`}>
  <!-- video (subtle internal parallax). Poster is the clip's OWN first frame, so
       any pre-load / re-buffer flash is the real footage, not a stray image.
       Save-Data / low tier gets a brand gradient instead of the video. -->
  <div class="vi-video absolute inset-0 w-full h-[130%] -top-[15%]">
    {lite ? (
      <div class="w-full h-full" style="background: radial-gradient(70% 70% at 50% 45%, color-mix(in srgb, var(--accent) 16%, transparent), var(--bg-primary))"></div>
    ) : (
      <video class="w-full h-full object-cover" muted loop playsinline autoplay preload="metadata"
        poster="/assets/fs/interlude-poster.webp" disablepictureinpicture>
        <source src={webm} type="video/webm" />
        <source src={src} type="video/mp4" />
      </video>
    )}
  </div>

  {overlay === 'gradient' && <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-bg-primary"></div>}
  {overlay === 'dark' && <div class="absolute inset-0 bg-bg-primary/60"></div>}

  <!-- narrative glass card -->
  <div class="vi-glass absolute inset-0 z-50 flex flex-col items-center justify-center pointer-events-none px-[8vw] py-[7vh]">
    <div class="max-w-5xl w-full text-center space-y-3 px-8 py-10 md:px-12 md:py-14 border border-white/10"
      style="background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02)); backdrop-filter: blur(16px) saturate(1.2); -webkit-backdrop-filter: blur(16px) saturate(1.2); box-shadow: 0 8px 32px rgba(0,0,0,0.3), inset 0 1px 0 rgba(255,255,255,0.08);"
      data-reveal-stagger>
      {lineItems.map((it) => (it.gap ? <div class="h-6"></div> : <p class={it.cls}>{it.text}</p>))}
      <p class="pt-4 font-serif text-[clamp(1.2rem,2.5vw,1.5rem)] text-white">
        {momentContent.closer.before} <em class="text-accent">{momentContent.closer.emphasis}</em>
      </p>
    </div>
  </div>

  <!-- bottom edge fade — grounds the clip into the next section. The TOP edge is
       feathered to transparent via a mask on .vi-video (below), so the video
       dissolves into the live scene behind it rather than a solid dark bar. -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-bg-primary to-transparent"></div>
  </div>
</div>

<style>
  /* Feather the top edge to transparent so the clip dissolves into the live
     scene behind it. The element is overscanned (h-130% / -top-15% for the
     parallax), so the visible top sits at ~11.5% of the box — the transparent
     band is placed there, fading to opaque just below. */
  .vi-video {
    -webkit-mask-image: linear-gradient(to bottom, transparent 9%, #000 22%, #000 100%);
    mask-image: linear-gradient(to bottom, transparent 9%, #000 22%, #000 100%);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .vi { animation: vi-rollup linear both; animation-timeline: view(); animation-range: entry 0% entry 40%; }
      .vi-video { animation: vi-par linear both; animation-timeline: view(); animation-range: contain; }
      .vi-glass { animation: vi-glass linear both; animation-timeline: view(); animation-range: cover 15% cover 85%; }
    }
  }
  @keyframes vi-rollup { from { transform: translateY(120px) scale(0.95); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes vi-par { from { transform: translateY(0); } to { transform: translateY(8%); } }
  @keyframes vi-glass { 0% { opacity: 0; } 40%,60% { opacity: 1; } 100% { opacity: 0; } }
</style>

<script>
  // Smooth forward loop (the old per-frame reverse-seek on a 4K video was the
  // jank source). Nudge playbackRate down slightly for a calmer, dreamier feel.
  document.querySelectorAll<HTMLVideoElement>('.vi video').forEach((video) => {
    video.playbackRate = 0.85
    video.play().catch(() => {})
  })
</script>
